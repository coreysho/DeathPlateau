# IDE settings are per machine.
.idea/

# Source caches for asset imports (rev 474, OSRS). Tens of MB each - never commit.
caches/

# Python bytecode, written whenever the tools/models scripts run.
__pycache__/
*.pyc

# Sim output. The God Wars sims write their findings next to the repo root
# (engine/tools/sim/gwdpopulate.ts and gwdgarrison.ts both writeFileSync('../<name>.json')),
# so these land here. They are reports regenerated by re-running the sim, not source.
gwdspawns.json
gwdgarrison.json

# A dev client run log. Written to whatever directory the client was started from, which is
# tools/ for the scripts that launch one and the repo root for tools/models/renderscene.py - so
# the pattern is unanchored rather than the tools/ path it used to be. Not source.
dev-client.log

# SceneRender compiled against the java client, which is how a map square is looked at without
# logging in (tools/models/renderscene.py puts this directory on the classpath). Rebuilt by the
# javac line in "Claude outputs/staff-zone/staff-zone.md" whenever it is needed. Not source.
tools/models/jagex2/
