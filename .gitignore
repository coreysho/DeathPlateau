# IDE settings are per machine.
.idea/

# Source caches for asset imports (rev 474, OSRS). Tens of MB each - never commit.
caches/

# Python bytecode, written whenever the tools/models scripts run.
__pycache__/
*.pyc

# Sim output. The God Wars sims write their findings next to the repo root
# (engine/tools/sim/gwdpopulate.ts and gwdgarrison.ts both writeFileSync('../<name>.json')),
# so these land here. They are reports regenerated by re-running the sim, not source.
gwdspawns.json
gwdgarrison.json

# A dev client run log, written beside the tools that start one. Not source.
tools/dev-client.log
