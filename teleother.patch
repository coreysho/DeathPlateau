diff --git a/scripts/interface_options/configs/game_options.constant b/scripts/interface_options/configs/game_options.constant
new file mode 100644
index 00000000..25ce3efe
--- /dev/null
+++ b/scripts/interface_options/configs/game_options.constant
@@ -0,0 +1,14 @@
+// Accept aid, the setting Teleother reads (Corey, 2026-09-21).
+//
+// A TRI-STATE, and the reason is that a varp has no default: every varp starts at 0 for every
+// save that has never written it, and there is no `default=` line in VarPlayerType. If this were
+// the obvious 0=no / 1=yes, then every account in existence would be refusing aid until it went
+// looking for a setting nobody has ever mentioned, and the first thing anyone would learn about
+// Teleother is that it does not work. OSRS has Accept aid ON by default.
+//
+// So 0 is "never chosen", and it reads as accepting. The Yes button lights on `lt,2` rather than
+// `eq,1`, which is also a display fix: before this, a player who had never touched the setting had
+// NEITHER Yes nor No lit.
+^aid_unset = 0
+^aid_yes = 1
+^aid_no = 2
