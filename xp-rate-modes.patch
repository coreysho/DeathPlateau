+ (RS2, 'if (%tutorial >= ^tutorial_complete) {\n    return;\n}\np_arrivedelay;\nif_openmain(xprate_choose);',
+       'p_arrivedelay;\nif_openmain(xprate_choose);\nif (%tutorial >= ^tutorial_complete) {\n    return;\n}',
