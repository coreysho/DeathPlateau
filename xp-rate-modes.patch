+// XP rate modes (Corey, 2026-09-18) - see claude/xp-rate-modes.md.
+//
+// THE VARP HOLDS THE RATE ITSELF, not a mode index. That is the whole trick: Player.addXp reads
+// the number and multiplies by it, so the ENGINE needs no table of modes and these three values
+// are the only place the rates are written down. A mode index would have meant the same three
+// numbers living in the engine too, where content cannot see them drift.
+//
+// 0 means never chosen, and the engine reads it as 1 - the authentic rate, which is exactly what
+// the server did before this existed. So every character that already exists is untouched, and a
+// player who closes the window without choosing plays at 1x and is asked again.
+^xprate_unset = 0
+^xprate_realism = 1
+^xprate_5x = 5
+^xprate_10x = 10
+
+// The three the chooser offers, in the order it draws them. Read by tools/genxpratechooser.py.
+^xprate_modes = 3
diff --git a/scripts/gamemodes/configs/gamemode.varp b/scripts/gamemodes/configs/gamemode.varp
new file mode 100644
index 00000000..3379f01b
--- /dev/null
+++ b/scripts/gamemodes/configs/gamemode.varp
@@ -0,0 +1,12 @@
+// The player's XP multiplier: 1, 5 or 10, or 0 for "never chosen" (which the engine reads as 1).
+//
+// scope=perm because it is the account's for good - it is chosen once on Tutorial Island and
+// ~xprate_choose refuses to ask again once the tutorial is complete, so a finished account can
+// never move itself onto a faster rate.
+//
+// NOT transmitted. The first draft was, so the chooser's boxes could highlight the chosen mode
+// client-side - but ~xprate_choose returns early once a rate is set, so the window is only ever
+// open while the rate is unset and there is never anything to highlight. The client has no other
+// use for the number; the engine reads it server-side in Player.addXp.
+[xp_rate]
+scope=perm
