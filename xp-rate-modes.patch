+  "addXp multiplies by the player's own rate as well as the world's"),
+ (PLAYER, "        if (Player.xpRateVarp === -2) {\n            Player.xpRateVarp = VarPlayerType.getId('xp_rate');\n        }",
+          '        Player.xpRateVarp = 1176;',
