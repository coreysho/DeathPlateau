diff --git a/scripts/minigames/game_trail/configs/trail.constant b/scripts/minigames/game_trail/configs/trail.constant
index 9673ef4b..346f783f 100644
--- a/scripts/minigames/game_trail/configs/trail.constant
+++ b/scripts/minigames/game_trail/configs/trail.constant
@@ -13,3 +13,19 @@
 ^trail_easy_droprate = 128
 ^trail_medium_droprate = 128
 ^trail_hard_droprate = 128
+
+// THE CLUE HUNTER OUTFIT. None of these three numbers is OSRS's - the outfit does nothing for
+// clues there at all - so they are Corey's, and tools/cluehunterspec.json says so beside them.
+//
+// The two percentages are full-set only and are rolled separately, at different moments: the
+// skip when a clue is handed in, the double when a trail finishes. So they never share a draw.
+^clue_hunter_double_pct = 10
+^clue_hunter_skip_pct = 10
+
+// PER CASKET ROLL, for each piece not already owned. Six independent waits at 1/750 is about
+// 1837 rolls for the whole set. The three tiers do not roll the same number of times - easy is
+// 2 + random(3), medium 3 + random(3), hard 4 + random(3) - so that is roughly 612 easy caskets,
+// 459 medium or 367 hard. The 600 is the point of the number: it was 1/1500 first and was halved
+// to land there.
+^clue_hunter_drop_denom = 750
+^clue_hunter_pieces = 6
diff --git a/scripts/minigames/game_trail/scripts/clue_hunter.rs2 b/scripts/minigames/game_trail/scripts/clue_hunter.rs2
new file mode 100644
index 00000000..a9bee031
--- /dev/null
+++ b/scripts/minigames/game_trail/scripts/clue_hunter.rs2
@@ -0,0 +1,94 @@
+// WHAT THE CLUE HUNTER OUTFIT DOES. GENERATED - do not hand-edit.
+//   python3 tools/gencluehunter.py
+//
+// NONE OF THIS IS OSRS'S. There the outfit has leather-armour stats, counts as warm
+// clothing, and does nothing at all for clues - no casket bonus, no step reduction. All
+// three effects below were asked for by name, and tools/cluehunterspec.json records that
+// under what_osrs_actually_does so nobody later reads them as canon.
+//
+// WHERE EACH ONE IS HOOKED, and why there:
+//   ~clue_hunter_doubles   the three ~trail_clue_<tier>_reward procs, right after they
+//                          work out how many times to roll - which is the only place a
+//                          "double casket" can mean anything precise.
+//   ~clue_hunter_skips     ~trail_clue_progress in trail_clue_helper.rs2, which every
+//                          tier goes through, so one hook covers easy, medium and hard.
+//   ~clue_hunter_droproll  inside the same reward loop, once per roll. It does NOT ask
+//                          whether the set is worn, for the obvious reason.
+
+// ALL SIX, EACH IN THE SLOT IT IS ACTUALLY WORN IN. Corey asked for a full-set effect, so
+// a partial set does nothing beyond its stats. Looking a piece up in the wrong slot is
+// the mistake the Rogue outfit battery check was written for, and clue_battery.py checks
+// this the same way - against the wearpos in the obj config, not against a list here.
+[proc,clue_hunter_worn]()(boolean)
+if (inv_getobj(worn, ^wearpos_hat) ! helm_of_raedwald) {
+    return(false);
+}
+if (inv_getobj(worn, ^wearpos_torso) ! clue_hunter_garb) {
+    return(false);
+}
+if (inv_getobj(worn, ^wearpos_hands) ! clue_hunter_gloves) {
+    return(false);
+}
+if (inv_getobj(worn, ^wearpos_legs) ! clue_hunter_trousers) {
+    return(false);
+}
+if (inv_getobj(worn, ^wearpos_feet) ! clue_hunter_boots) {
+    return(false);
+}
+if (inv_getobj(worn, ^wearpos_back) ! clue_hunter_cloak) {
+    return(false);
+}
+return(true);
+
+// A DOUBLED CASKET IS TWICE THE ROLLS. A casket rolls 2 + random(3) times, so doubling
+// the count gives 4, 6 or 8 - exactly two caskets' worth of the same table, rather than
+// a second roll on a different one.
+[proc,clue_hunter_doubles]()(boolean)
+if (~clue_hunter_worn = false) {
+    return(false);
+}
+if (random(100) < ^clue_hunter_double_pct) {
+    return(true);
+}
+return(false);
+
+// A SKIPPED STEP advances the trail twice for one hand-in. This is not a new idea in the
+// file: ~trail_clue_<tier>_complete already finishes a trail early when progress + 2
+// reaches maxsteps and a coin flip agrees, so early completion predates the outfit.
+[proc,clue_hunter_skips]()(boolean)
+if (~clue_hunter_worn = false) {
+    return(false);
+}
+if (random(100) < ^clue_hunter_skip_pct) {
+    return(true);
+}
+return(false);
+
+// THE SET COMES OUT OF CASKETS, one roll per piece per casket roll, and only for a piece
+// the player does not already have somewhere - inventory, bank or worn. Two reasons: an
+// untradeable outfit piece arriving twice is pure clutter, and skipping the ones already
+// owned is what makes the rate for a given piece exactly 1/^clue_hunter_drop_denom until
+// it is found, which is the number that was asked for.
+//
+// DELIBERATELY NOT IN THE RARE TABLES. Those reach 1/97 a roll through arithmetic that
+// is derived and commented in the reward scripts, and six new entries would move every
+// existing rare's rate and make that comment wrong.
+[proc,clue_hunter_droproll]
+if (~obj_gettotal(helm_of_raedwald) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, helm_of_raedwald, 1);
+}
+if (~obj_gettotal(clue_hunter_garb) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, clue_hunter_garb, 1);
+}
+if (~obj_gettotal(clue_hunter_gloves) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, clue_hunter_gloves, 1);
+}
+if (~obj_gettotal(clue_hunter_trousers) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, clue_hunter_trousers, 1);
+}
+if (~obj_gettotal(clue_hunter_boots) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, clue_hunter_boots, 1);
+}
+if (~obj_gettotal(clue_hunter_cloak) = 0 & random(^clue_hunter_drop_denom) = 0) {
+    inv_add(trail_rewardinv, clue_hunter_cloak, 1);
+}
diff --git a/scripts/minigames/game_trail/scripts/easy/trail_clue_easy_reward.rs2 b/scripts/minigames/game_trail/scripts/easy/trail_clue_easy_reward.rs2
index d813b545..ba30b738 100644
--- a/scripts/minigames/game_trail/scripts/easy/trail_clue_easy_reward.rs2
+++ b/scripts/minigames/game_trail/scripts/easy/trail_clue_easy_reward.rs2
@@ -4,6 +4,13 @@
 ~trail_prepare_rewardinv;
 // Rolls math verification: https://www.youtube.com/watch?v=Er4RAFnmTvs
 def_int $rolls = calc(2 + random(3));
+// THE CLUE HUNTER OUTFIT'S DOUBLE CASKET. Twice the rolls on this same table is exactly two
+// caskets' worth - 4, 6 or 8 instead of 2, 3 or 4 - which is the only precise reading of "double
+// casket" when a casket is a roll count. Asked for by name; OSRS's outfit does nothing like it.
+if (~clue_hunter_doubles = true) {
+    $rolls = calc($rolls * 2);
+    mes("Your clue hunter outfit turns up a second casket's worth of loot!");
+}
 def_int $roll = 0;
 def_int $rare = 0;
 
@@ -23,6 +30,10 @@ while ($roll < $rolls) {
     } else {
         gosub(trail_clue_easy_normal);
