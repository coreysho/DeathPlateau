diff --git a/scripts/areas/area_barrows/scripts/barrows_chest.rs2 b/scripts/areas/area_barrows/scripts/barrows_chest.rs2
new file mode 100644
index 00000000..895b31f0
--- /dev/null
+++ b/scripts/areas/area_barrows/scripts/barrows_chest.rs2
@@ -0,0 +1,144 @@
+// The Barrows chest: opening it, what it pays, and the brother it lets out.
+//
+// THE OPS ARE THE CACHE'S. barrows_stone_chest is a multiloc on barrows_chest_open: closed it
+// carries Open, open it carries Search and Close. So this is a two-stage chest rather than the
+// one-click loot Old School has, and each op does something - Open lets the last brother out and
+// starts the shaking, Search pays, Close shuts it again.
+//
+// WHAT IT PAYS is tools/barrowschestspec.json, which quotes the wiki: one roll plus one per
+// brother killed to a ceiling of seven; per roll a piece of Barrows equipment at
+// 1/(450 - 58 * brothers) and only from brothers actually killed; otherwise a value rolled in
+// 1..potential and read against the bands, which ARE the "reward potential required" column.
+
+[oploc1,barrows_stone_chest_closed]
+p_arrivedelay;
+p_stopaction;
+facesquare(loc_coord);
+if (%barrows_entry_crypt = ^barrows_entry_none) {
+    // Nobody's run: no brothers, no potential, nothing owed. The chest still opens.
+    mes("You open the chest. It is empty.");
+    %barrows_chest_open = ^true;
+    return;
+}
+mes("You open the chest...");
+anim(human_openchest, 0);
+p_delay(1);
+%barrows_chest_open = ^true;
+// THE BROTHER WHOSE CRYPT YOU CAME IN BY. He was never in his sarcophagus - the passage was - so
+// this is where he turns up, unless a door already sent him or he is already dead.
+def_int $bit = sub(%barrows_entry_crypt, 1);
+def_npc $brother = ~barrows_brother_npc($bit);
+if (testbit(%barrows_kills, $bit) = ^false & ~barrows_brother_here($brother) = ^false) {
+    ~barrows_wake(coord, $brother);
+    ~mesbox("<nc_name($brother)> bursts out of the darkness!");
+} else {
+    mes("The tunnels begin to shake and dust falls from the ceiling.");
+}
+
+[oploc2,barrows_stone_chest_open]
+p_arrivedelay;
+p_stopaction;
+facesquare(loc_coord);
+%barrows_chest_open = ^false;
+mes("You close the chest.");
+
+// Is he already down here? A door can send the entry brother before the chest is ever opened -
+// "if he did not already appear while travelling through the tunnels" - and two of him would be a
+// second set of armour. 64 tiles reaches the whole tunnel square and no brother stands anywhere
+// else in the world.
+[proc,barrows_brother_here](npc $brother)(boolean)
+npc_findall(coord, $brother, 64, 1);
+if (npc_findnext = true) {
+    return(^true);
+}
+return(^false);
+
+// ---------------------------------------------------------------------------------------------
+// The reward
+// ---------------------------------------------------------------------------------------------
+[oploc1,barrows_stone_chest_open]
+p_arrivedelay;
+p_stopaction;
+facesquare(loc_coord);
+if (%barrows_entry_crypt = ^barrows_entry_none | %barrows_chest_paid = ^true) {
+    mes("You search the chest and find nothing of interest.");
+    return;
+}
+def_int $brothers = ~barrows_brothers_killed;
+def_int $potential = min(add(%barrows_killed_monster,
+                             multiply($brothers, ^barrows_potential_brother)),
+                         ^barrows_potential_max);
+if ($potential <= 0) {
+    mes("You search the chest, but you have done nothing to earn its contents.");
+    return;
+}
+anim(human_openchest, 0);
+p_delay(1);
+%barrows_chest_paid = ^true;
+def_int $rolls = min(add(^barrows_rolls_base, $brothers), ^barrows_rolls_max);
+def_int $n = 0;
+while ($n < $rolls) {
+    ~barrows_reward_roll($brothers, $potential);
+    $n = add($n, 1);
+}
+// COREY'S ADDITION, and the one thing here Old School does not have.
+if (random(^barrows_tele_rate) = 0) {
+    ~obj_giveorbank(barrows_teleport, ~barrows_between(^barrows_tele_low, ^barrows_tele_high));
+}
+~mesbox("You loot the chest, and the tunnels shudder around you. Time to leave.");
+
+[proc,barrows_reward_roll](int $brothers, int $potential)
+// A PIECE OF ARMOUR FIRST, and only from a brother who was killed: 1/(450 - 58 * brothers), which
+// is 1/392 with one down and 1/102 with all six. With none down there is no piece to give.
+def_int $odds = sub(^barrows_equip_base, multiply(^barrows_equip_step, $brothers));
+if ($brothers > 0 & random($odds) = 0) {
+    def_int $bit = ~barrows_nth_killed(random($brothers));
+    def_int $piece = add(multiply($bit, ^barrows_equip_pieces), random(^barrows_equip_pieces));
+    ~obj_giveorbank(enum(int, namedobj, barrows_equipment, $piece), 1);
+    return;
+}
+// "A roll is performed for a value between 1 and your reward potential (each inclusive)", and the
+// reward is the last band that roll reached.
+def_int $roll = add(random($potential), 1);
+if ($roll >= ^barrows_rp_dragonmed) {
+    ~obj_giveorbank(dragon_med_helm, 1);
+} else if ($roll >= ^barrows_rp_keyhalf) {
+    // "Key halves, 1 each" - the crystal key's tooth end and loop end, one or the other.
+    if (random(2) = 0) {
+        ~obj_giveorbank(keyhalf1, 1);
+    } else {
+        ~obj_giveorbank(keyhalf2, 1);
+    }
+} else if ($roll >= ^barrows_rp_boltrack) {
+    ~obj_giveorbank(barrows_karil_ammo,
+                    ~barrows_between(^barrows_loot_boltrack_low, ^barrows_loot_boltrack_high));
+} else if ($roll >= ^barrows_rp_blood) {
+    ~obj_giveorbank(bloodrune, ~barrows_between(^barrows_loot_blood_low, ^barrows_loot_blood_high));
+} else if ($roll >= ^barrows_rp_death) {
+    ~obj_giveorbank(deathrune, ~barrows_between(^barrows_loot_death_low, ^barrows_loot_death_high));
+} else if ($roll >= ^barrows_rp_chaos) {
+    ~obj_giveorbank(chaosrune, ~barrows_between(^barrows_loot_chaos_low, ^barrows_loot_chaos_high));
+} else if ($roll >= ^barrows_rp_mind) {
+    ~obj_giveorbank(mindrune, ~barrows_between(^barrows_loot_mind_low, ^barrows_loot_mind_high));
+} else {
+    ~obj_giveorbank(coins, ~barrows_between(^barrows_loot_coins_low, ^barrows_loot_coins_high));
+}
+
+// Inclusive both ends, which is how every quantity in the wiki's table is written.
+[proc,barrows_between](int $low, int $high)(int)
+return(add($low, random(add(sub($high, $low), 1))));
+
+// The $n-th brother who IS dead, counting from 0 - the mirror of ~barrows_nth_unkilled, and what
+// makes the equipment table reachable only through a brother the player actually beat.
+[proc,barrows_nth_killed](int $n)(int)
+def_int $bit = 0;
+while ($bit < ^barrows_brothers) {
+    if (testbit(%barrows_kills, $bit) = ^true) {
+        if ($n = 0) {
+            return($bit);
+        }
+        $n = sub($n, 1);
+    }
+    $bit = add($bit, 1);
+}
+return(-1);
diff --git a/scripts/areas/area_barrows/scripts/barrows_teleport.rs2 b/scripts/areas/area_barrows/scripts/barrows_teleport.rs2
new file mode 100644
index 00000000..85a319f7
--- /dev/null
+++ b/scripts/areas/area_barrows/scripts/barrows_teleport.rs2
@@ -0,0 +1,32 @@
+// The Barrows teleport tab.
+//
+// COREY'S ADDITION, and the one thing in the Barrows that Old School's own chest does not pay.
+// The item IS Old School's though - obj 19629, model 31539, imported with the same 2d camera the
+// fourteen lectern tablets carry (2dzoom 465, 2dxan 373, 2dyof -1), which is why it sits in the
+// pack looking like the rest of them. The cache names no cost for it, so none is written here.
+//
+// WHERE IT LANDS is the tile Corey asked for, ^barrows_tele_dest, north of the mounds.
+//
+// The checks are ~poh_tab_teleport's, because breaking a tablet is breaking a tablet: not a way
+// out of deep wilderness, a duel or the trawler. What it does NOT share is the spell row - there
+// is no Barrows teleport spell to read a destination out of, so the coord is a constant.
+[opheld1,barrows_teleport]
+if (~wilderness_level(coord) > 20) {
+    mes("A mysterious force blocks your teleport!");
+    mes("You can't use this teleport after level 20 wilderness.");
+    return;
+}
+if (~pre_tele_checks(coord) = false) {
+    return;
+}
+if (inv_total(inv, barrows_teleport) < 1) {
+    return;
+}
+inv_del(inv, barrows_teleport, 1);
+mes("You break the tablet.");
+if_close;
+p_stopaction;
+sound_synth(teleport_all, 1, 0);
+~poh_tab_breakanim;
+p_delay(2);
+~p_telejump_safe(^barrows_tele_dest);
diff --git a/scripts/areas/area_barrows/scripts/barrows_tunnels.rs2 b/scripts/areas/area_barrows/scripts/barrows_tunnels.rs2
new file mode 100644
index 00000000..8a5e4167
--- /dev/null
+++ b/scripts/areas/area_barrows/scripts/barrows_tunnels.rs2
@@ -0,0 +1,307 @@
+// The Barrows tunnels: the passage in, the sixteen doors, what comes out of them, and the reward
+// potential that everything down here pays into.
+//
+// NOTHING HERE NEEDED ART OR CONFIG. 377 already ships the whole tunnel: the rooms, the chest, the
+// thirty-four monsters, four ladders that are multilocs on their own chamber bit, and sixteen door
+// pairs that are multilocs on their own door bit with a locked form and an unlocked form carrying
+// Open. What did not exist was a single handler. See barrows.constant for the bit map.
+//
+// THE MAZE IS CHOSEN, NOT BUILT. Old School randomises which doors open every run and the chest
+// must stay reachable; tools/barrowsmaze.py works that out against maps/m55_151.jm2 offline and
+// barrows.enum holds twenty-four masks that all pass. One setbit_range_toint lays a whole maze.
+
+// ---------------------------------------------------------------------------------------------
+// Starting a run
+// ---------------------------------------------------------------------------------------------
+// %barrows_entry_crypt holds a brother's bit plus one, so 0 means no run is on. It is rolled by
+// the first dig of a run and cleared by looting the chest, and it decides three things: which
+// sarcophagus gives the passage instead of its brother, which brother the chest hands you, and
+// whether anything down here counts for anything at all.
+[proc,barrows_begin_run]
+// A run that is still owed its chest keeps everything: the maze, the ladder, the brothers already
+// down, the potential. A run whose chest has paid is over, and the next hole in the ground is the
+// next run - which is why looting does not clear anything itself.
+if (%barrows_entry_crypt ! ^barrows_entry_none & %barrows_chest_paid = ^false) {
+    return;
+}
+%barrows_entry_crypt = add(random(^barrows_brothers), 1);
+// A fresh run owes nothing and has killed nobody. The doors are laid when the passage is found
+// rather than here, because a player who never finds it never needs a maze.
+%barrows_kills = 0;
+%barrows_chest_paid = ^false;
+%barrows_chest_open = ^false;
+%barrows = setbit_range_toint(%barrows, 0, ^barrows_door_first, ^barrows_door_last);
+~barrows_shut_ladders;
+
+// ---------------------------------------------------------------------------------------------
+// The passage
+// ---------------------------------------------------------------------------------------------
+// Six crypts, four ladders: the chamber cannot be read off the crypt, so it is rolled on the way
+// in and then remembered by the only bit that can remember it - the one that makes its ladder
+// exist. Coming back down the same run returns you to the same chamber and the same maze.
+[proc,barrows_passage]
+mes("You search the sarcophagus...");
+anim(human_openchest, 0);
+p_delay(1);
+def_int $chamber = ~barrows_open_chamber;
+if ($chamber < 0) {
+    $chamber = random(^barrows_chambers);
+    ~barrows_open_ladder($chamber);
+    %barrows = setbit_range_toint(%barrows, enum(int, int, barrows_mazes, random(^barrows_mazes)), ^barrows_door_first, ^barrows_door_last);
+    ~mesbox("You have found a passage into the Barrows tunnels!");
+} else {
+    ~mesbox("You climb back down into the tunnels.");
+}
+p_telejump(~barrows_chamber_tile($chamber));
+
+// A fresh run owns no chamber. Leaving the old ladder standing would make ~barrows_open_chamber
+// answer with it, and the next run would inherit the last one's maze.
+[proc,barrows_shut_ladders]
+%barrows_chamber_a = ^false;
+%barrows_chamber_c = ^false;
+%barrows_chamber_g = ^false;
+%barrows_chamber_i = ^false;
+
+// The chamber this run is using, or -1 when it has not picked one yet.
+[proc,barrows_open_chamber]()(int)
+if (%barrows_chamber_a = ^true) {
+    return(^barrows_chamber_a);
+} else if (%barrows_chamber_c = ^true) {
+    return(^barrows_chamber_c);
+} else if (%barrows_chamber_g = ^true) {
+    return(^barrows_chamber_g);
+} else if (%barrows_chamber_i = ^true) {
+    return(^barrows_chamber_i);
+}
+return(-1);
+
+[proc,barrows_open_ladder](int $chamber)
+switch_int ($chamber) {
+    case ^barrows_chamber_a : %barrows_chamber_a = ^true;
+    case ^barrows_chamber_c : %barrows_chamber_c = ^true;
+    case ^barrows_chamber_g : %barrows_chamber_g = ^true;
+    case ^barrows_chamber_i : %barrows_chamber_i = ^true;
+}
+
+[proc,barrows_chamber_tile](int $chamber)(coord)
+switch_int ($chamber) {
+    case ^barrows_chamber_a : return(^barrows_chamber_tile_a);
+    case ^barrows_chamber_c : return(^barrows_chamber_tile_c);
+    case ^barrows_chamber_g : return(^barrows_chamber_tile_g);
+    case ^barrows_chamber_i : return(^barrows_chamber_tile_i);
+}
+return(null);
+
+// ---------------------------------------------------------------------------------------------
+// The way out
+// ---------------------------------------------------------------------------------------------
+// All four ladders are the same loc once their bit is set, so one handler serves them, and it puts
+// the player back on the mound of the crypt they came in by - the hole they dug is the way out.
+[oploc1,barrows_ladder]
+p_arrivedelay;
+p_stopaction;
+mes("You climb the ladder...");
+~climb_ladder(~barrows_entry_mound, true);
+mes("...and come out on the surface.");
+
+[proc,barrows_entry_mound]()(coord)
+// %barrows_entry_crypt is the brother's bit PLUS ONE so that 0 can mean "no run", and a switch
+// case has to be a constant, so the plus one comes off here rather than going onto the cases.
+switch_int (sub(%barrows_entry_crypt, 1)) {
+    case ^barrows_bit_ahrim : return(^barrows_mound_ahrim);
+    case ^barrows_bit_dharok : return(^barrows_mound_dharok);
+    case ^barrows_bit_guthan : return(^barrows_mound_guthan);
+    case ^barrows_bit_karil : return(^barrows_mound_karil);
+    case ^barrows_bit_torag : return(^barrows_mound_torag);
+    case ^barrows_bit_verac : return(^barrows_mound_verac);
+}
+// No run: the middle mound is where the wiki puts the Strange Old Man and is the one tile on the
+// surface that is certainly a mound, so a player who got down here another way is not stranded.
+return(^barrows_mound_ahrim);
+
+// ---------------------------------------------------------------------------------------------
+// The doors
+// ---------------------------------------------------------------------------------------------
+// The unlocked form is the only one carrying Open, so a locked door needs no handler and no
+// message: the client draws it darker and it has no option, which is 377's own answer to "not all
+// of the doors in these tunnels can be opened".
+//
+// The door does not swing. There is no open form of it in the cache - barrows_door_inactive_l is
+// the same model with no ops at all - so what a click does is carry the player through the
+// doorway, the way general_use/scripts/fence.rs2 carries them through a fence, and then let
+// something out behind them.
+[oploc1,barrows_door_unlocked_l] ~barrows_door_through;
+[oploc1,barrows_door_unlocked_r] ~barrows_door_through;
+
+[proc,barrows_door_through]
+p_arrivedelay;
+p_stopaction;
+def_coord $start = loc_coord;
+def_coord $end = ~movecoord_loc_return(~door_open(loc_angle, loc_shape));
+def_int $dir;
+switch_int (loc_angle) {
+    case ^loc_west : $dir = ^exact_west;
+    case ^loc_north : $dir = ^exact_north;
+    case ^loc_east : $dir = ^exact_east;
+    case ^loc_south : $dir = ^exact_south;
+}
+if (~check_axis(coord, loc_coord, loc_angle) = false) {
+    $start = ~movecoord_loc_return(~door_open(loc_angle, loc_shape));
+    $end = loc_coord;
+    switch_int (loc_angle) {
+        case ^loc_west : $dir = ^exact_east;
+        case ^loc_north : $dir = ^exact_south;
+        case ^loc_east : $dir = ^exact_west;
+        case ^loc_south : $dir = ^exact_north;
+    }
+}
+if (coord ! $start) {
+    p_teleport($start);
+    p_delay(1);
+}
+facesquare($end);
+p_delay(0);
+~agility_exactmove(human_walk_style, 0, 2, $start, $end, 0, 76, $dir, true);
+p_teleport($end);
+~barrows_door_spawn($end);
+
+// WHAT COMES THROUGH WITH YOU, out of 128 and from the wiki: 12 a brother you have not killed, 52
+// a skeleton, 32 a bloodworm, 32 a crypt rat - unless the room is already holding eleven, in which
+// case nothing comes. AFTER THE CHEST IS LOOTED every door is a brother instead, which is the
+// wiki's own "each door you open is guaranteed to summon one of the brothers whom you did not
+// kill" and is the only way the last brother can be met before the chest is opened at all.
+[proc,barrows_door_spawn](coord $where)
+if (%barrows_entry_crypt = ^barrows_entry_none) {
+    return;
+}
+if (~barrows_crowd($where) >= ^barrows_spawn_crowd) {
+    return;
+}
+def_int $roll = random(^barrows_spawn_denom);
+if (%barrows_chest_paid = ^true) {
+    $roll = 0;
+}
+if ($roll < ^barrows_spawn_brother) {
+    ~barrows_spawn_brother($where);
+    return;
+}
+def_npc $monster = barrows_rat;
+if ($roll < ^barrows_spawn_skeleton) {
+    $monster = barrows_skeleton_armed;
+    if (random(2) = 0) {
+        $monster = barrows_skeleton_unarmed;
+    }
+} else if ($roll < ^barrows_spawn_bloodworm) {
+    $monster = barrows_bloodworm;
+}
+~barrows_wake($where, $monster);
+
+// How many npcs are already in earshot of the tile the player stepped onto. npc_findallany counts
+// everything, which is what the wiki's "eleven enemies" means - there is nothing else down here.
+[proc,barrows_crowd](coord $where)(int)
+def_int $count = 0;
+npc_findallany($where, ^barrows_spawn_range, 1);
+while (npc_findnext = true) {
+    $count = add($count, 1);
+}
+return($count);
+
+// A brother out of a door is one you have NOT killed, picked evenly among those left. With none
+// left there is nothing to send, so a skeleton comes instead rather than nothing at all.
+[proc,barrows_spawn_brother](coord $where)
+def_int $left = sub(^barrows_brothers, ~barrows_brothers_killed);
+if ($left <= 0) {
+    ~barrows_wake($where, barrows_skeleton_armed);
+    return;
+}
+~barrows_wake($where, ~barrows_brother_npc(~barrows_nth_unkilled(random($left))));
+
+[proc,barrows_wake](coord $where, npc $monster)
+npc_add($where, $monster, ^barrows_brother_life);
+%npc_aggressive_player = uid;
+%aggressive_npc = npc_uid;
+npc_setmode(opplayer2);
+
+// ---------------------------------------------------------------------------------------------
+// Counting the brothers
+// ---------------------------------------------------------------------------------------------
+// Bits 0-5 of %barrows_kills are the six barrows_killed_* varbits, so they can be counted and
+// indexed as one int - which is what the chest's roll count, its equipment table and the doors'
+// brother all need.
+[proc,barrows_brothers_killed]()(int)
+def_int $bit = 0;
+def_int $count = 0;
+while ($bit < ^barrows_brothers) {
+    if (testbit(%barrows_kills, $bit) = ^true) {
+        $count = add($count, 1);
+    }
+    $bit = add($bit, 1);
+}
+return($count);
+
+// The $n-th brother still alive, counting from 0. Used with random(brothers left), so it always
+// lands on one; -1 would mean the caller asked for a brother that is not there.
+[proc,barrows_nth_unkilled](int $n)(int)
+def_int $bit = 0;
+while ($bit < ^barrows_brothers) {
+    if (testbit(%barrows_kills, $bit) = ^false) {
+        if ($n = 0) {
+            return($bit);
+        }
+        $n = sub($n, 1);
+    }
+    $bit = add($bit, 1);
+}
+return(-1);
+
+[proc,barrows_brother_npc](int $bit)(npc)
+switch_int ($bit) {
+    case ^barrows_bit_ahrim : return(barrows_ahrim);
+    case ^barrows_bit_dharok : return(barrows_dharok);
+    case ^barrows_bit_guthan : return(barrows_guthan);
+    case ^barrows_bit_karil : return(barrows_karil);
+    case ^barrows_bit_torag : return(barrows_torag);
+    case ^barrows_bit_verac : return(barrows_verac);
+}
+return(null);
+
+// ---------------------------------------------------------------------------------------------
+// Reward potential
+// ---------------------------------------------------------------------------------------------
+// Called from [proc,npc_death] beside ~check_progress_task, because that is the one place every
+// death passes through and the tunnel monsters are not all hookable: the two skeletons already
+// carry an [ai_queue3] for their drop table, and a second trigger on the same npc is a hard build
+// error. The proc asks three questions and answers nothing otherwise.
+//
+// THE BROTHERS DO NOT PAY INTO THE POOL. The wiki gives monsters their combat level into a total
+// capped at 1000 and brothers a flat 2 each, "capping the maximum reward potential at 1,012" - and
+// 1000 + 6*2 is the only reading of that number in which a brother pays 2 and nothing more. Their
+// 2 each is added by the chest, off the six killed bits, so it cannot be paid twice.
+[proc,barrows_potential]
+if (inzone(^barrows_tunnel_sw, ^barrows_tunnel_ne, npc_coord) = ^false) {
+    return;
+}
+if (~barrows_brother_bit(npc_type) >= 0) {
+    return;
+}
+if (npc_findhero = ^false) {
+    return;
+}
+if (%barrows_entry_crypt = ^barrows_entry_none) {
+    return;
+}
+%barrows_killed_monster = min(add(%barrows_killed_monster, nc_vislevel(npc_type)), ^barrows_potential_cap);
+%barrows_killed_count = add(%barrows_killed_count, 1);
+
+// Which of the six a dying npc is, or -1 for anything else - the guard that keeps the brothers out
+// of the monster pool, and the same question the chest asks of a door's brother.
+[proc,barrows_brother_bit](npc $brother)(int)
+switch_npc ($brother) {
+    case barrows_ahrim : return(^barrows_bit_ahrim);
+    case barrows_dharok : return(^barrows_bit_dharok);
+    case barrows_guthan : return(^barrows_bit_guthan);
+    case barrows_karil : return(^barrows_bit_karil);
+    case barrows_torag : return(^barrows_bit_torag);
+    case barrows_verac : return(^barrows_bit_verac);
+}
+return(-1);
