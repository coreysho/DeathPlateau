+val=6,barrows_dharok_legs
+val=7,barrows_dharok_weapon
+val=8,barrows_guthan_head
+val=9,barrows_guthan_body
+val=10,barrows_guthan_legs
+val=11,barrows_guthan_weapon
+val=12,barrows_karil_head
