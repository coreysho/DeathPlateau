diff --git a/scripts/areas/area_barrows/configs/barrows.varbit b/scripts/areas/area_barrows/configs/barrows.varbit
new file mode 100644
index 00000000..a1dd62e6
--- /dev/null
+++ b/scripts/areas/area_barrows/configs/barrows.varbit
@@ -0,0 +1,19 @@
+// WHICH CRYPT THE PLAYER CAME IN BY, plus one, so that 0 means no run is in progress. Three bits
+// for six brothers, in the lowest bits of %barrows - the cache's own varbits on that var start at
+// bit 6 (barrows_chamber_a), so 0-5 were free and nothing in the client reads them.
+//
+// This is the only varbit the Barrows needed adding; everything else it stores was already here.
+[barrows_entry_crypt]
+basevar=barrows
+startbit=0
+endbit=2
+
+// WHETHER THIS RUN'S CHEST HAS ALREADY PAID. It cannot be %barrows_chest_open, because the open
+// chest carries Close as well as Search and a player who closes it would be able to open it and
+// loot it again; and it cannot be "clear the run on looting", because the run is what holds the
+// ladder the player still has to climb out by and the list of brothers a door is allowed to send.
+// So the loot sets this instead, and the next dig - not the ladder - is what starts a fresh run.
+[barrows_chest_paid]
+basevar=barrows
+startbit=3
+endbit=3
diff --git a/scripts/areas/area_barrows/configs/barrows.varp b/scripts/areas/area_barrows/configs/barrows.varp
deleted file mode 100644
index 71a13225..00000000
--- a/scripts/areas/area_barrows/configs/barrows.varp
+++ /dev/null
@@ -1,16 +0,0 @@
-// Which of the six brothers this player has killed on the run they are on. One bit each,
-// ^barrows_bit_* in barrows.constant.
-//
-// scope=perm rather than temp: a run survives a logout in Old School, and a player who logs out
-// mid-Barrows and comes back to six live brothers has lost the run they were doing.
-//
-// protect=no because the writer is a brother's death, which runs in npc context: npc_findhero
-// gives that script the player, but not PROTECTED access to him, and a protected var refuses the
-// write - "Attempt to access uninitialized pointer [ 'p_active_player' ]" at compile time. The
-// alternative is temple_guardian.rs2's p_finduid-or-queue dance, which is what a protected var
-// forces; protect=no is both shorter and more reliable here, because the bit then lands even when
-// the player is in the middle of another protected script, and mage_arena_2.rs2 marks its own
-// npc-death-written progress var exactly the same way.
-[barrows_killed]
-protect=no
-scope=perm
