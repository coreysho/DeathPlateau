 // Five of the six fire on a quarter of qualifying hits, which is one number and not five. Dharok's
 // is not in this list: his is not a chance, it is arithmetic on every hit.
 ^barrows_set_effect_pct = 25
+
+// =============================================================================================
+// THE DOOR BEFORE THE CHEST
+// =============================================================================================
+// EIGHT PUZZLES, which is what %barrows_puzzle's three bits hold - the cache's own field, and
+// nothing in the build was using it. Rolled with the maze and re-rolled whenever a wrong answer
+// shifts the tunnels. scripts/barrows_puzzle.rs2 says why the puzzle is words and not shapes.
+^barrows_puzzles = 8
+
+// WHICH GATES ASK IT is not a constant, deliberately: the four that open into the chest room are
+// e, i, j and l, and tools/barrowsmaze.py can see that off the map - the chest's own region is
+// joined to the rest of the tunnel by exactly those four, the spokes of the cross. So the battery
+// derives the set and checks the script's triggers against it, rather than both reading a list
+// somebody typed. One answer opens all four for the rest of a run.
diff --git a/scripts/areas/area_barrows/configs/barrows.inv b/scripts/areas/area_barrows/configs/barrows.inv
new file mode 100644
index 00000000..6a05cbf6
--- /dev/null
+++ b/scripts/areas/area_barrows/configs/barrows.inv
@@ -0,0 +1,12 @@
+// WHAT THE CHEST HAS PAID BUT THE PLAYER HAS NOT PICKED UP YET.
+//
+// scope=perm, because the alternative is losing loot: a disconnect between the roll and the last
+// click would drop a set piece on the floor of a run that is already over. The window shows this
+// inv directly, so what the player sees IS the store.
+//
+// Eight slots is the ceiling on one chest - seven rolls at six brothers killed, plus the teleport
+// tabs - and tools/genbarrowschest.py reads the size from here rather than repeating it, so the
+// grid cannot end up smaller than the thing it draws.
+[barrows_reward_store]
+scope=perm
+size=8
diff --git a/scripts/areas/area_barrows/configs/barrows.varbit b/scripts/areas/area_barrows/configs/barrows.varbit
index a1dd62e6..4aebb452 100644
--- a/scripts/areas/area_barrows/configs/barrows.varbit
+++ b/scripts/areas/area_barrows/configs/barrows.varbit
@@ -17,3 +17,11 @@ endbit=2
 basevar=barrows
 startbit=3
 endbit=3
+
+// WHETHER THIS RUN HAS ANSWERED THE DOOR. Bit 4 of %barrows, beside the entry crypt and the chest
+// flag. The PUZZLE ITSELF is bits 29-31, which the cache already had and nothing was using: three
+// bits, so eight of them, rolled with the maze and re-rolled every time the tunnels shift.
+[barrows_puzzle_solved]
+basevar=barrows
+startbit=4
+endbit=4
