diff --git a/scripts/skill_crafting/scripts/jewellery/silver_casting.rs2 b/scripts/skill_crafting/scripts/jewellery/silver_casting.rs2
new file mode 100644
index 00000000..816e4d10
--- /dev/null
+++ b/scripts/skill_crafting/scripts/jewellery/silver_casting.rs2
@@ -0,0 +1,161 @@
+// The furnace's Silver Casting window.
+// 
+// GENERATED by tools/genwindows.py. Edit tools/adoptspec.json, not this file.
+// 
+// WHAT THIS REPLACES. [label,craft_silver] in jewellery.rs2 is a seven-branch cascade of
+// p_choice2 and p_choice3 combinations, one per subset of the three moulds it knows about,
+// and it covers three of the panel's seven products. The panel does the same job with two
+// layers per product - one holding the item, one saying which mould you are missing - and
+// if_sethide picking between them. if_sethide only works on layers, and these are layers.
+// 
+// THIS IS THE ONE PLACE "keep both paths" COULD NOT HOLD. The old cascade and the window
+// are the same click - a silver bar on a furnace - so one of them has to win, and the
+// window is the one that shows all seven products and names the mould you lack.
+// 
+// Three of the seven have no obj in pack/obj.pack at all: the lightning rod, the silvthrill
+// rod and the demonic sigil belong to quests this build does not have. Their moulds do not
+// exist either, so those three panels simply never flip to the make state. Nothing special
+// is done about them and nothing needs to be.
+
+// There is NO [oplocu,_smithing_furnace] here on purpose: smelting.rs2 already owns that
+// trigger and a duplicate is a hard build error. Its silver_bar case calls this proc.
+[proc,silver_casting_open]
+if (inv_total(inv, holy_symbol_mould) > 0) {
+    inv_transmit(silvercast_holysymbol, silver_casting:slot_holy_symbol);
+    if_sethide(silver_casting:make_holy_symbol, false);
+    if_sethide(silver_casting:need_holy_symbol, true);
+} else {
+    if_sethide(silver_casting:make_holy_symbol, true);
+    if_sethide(silver_casting:need_holy_symbol, false);
+}
+if (inv_total(inv, unholy_symbol_mould) > 0) {
+    inv_transmit(silvercast_unholysymbol, silver_casting:slot_unholy_symbol);
+    if_sethide(silver_casting:make_unholy_symbol, false);
+    if_sethide(silver_casting:need_unholy_symbol, true);
+} else {
+    if_sethide(silver_casting:make_unholy_symbol, true);
+    if_sethide(silver_casting:need_unholy_symbol, false);
+}
+if (inv_total(inv, sickle_mould) > 0) {
+    inv_transmit(silvercast_sickle, silver_casting:slot_silver_sickle);
+    if_sethide(silver_casting:make_silver_sickle, false);
+    if_sethide(silver_casting:need_silver_sickle, true);
+} else {
+    if_sethide(silver_casting:make_silver_sickle, true);
+    if_sethide(silver_casting:need_silver_sickle, false);
+}
+// lightning_rod: a quest step with no Crafting level or experience to copy, and nothing
+// in this build hands out its mould, so it stays on the need side by itself.
+if_sethide(silver_casting:make_lightning_rod, true);
+if_sethide(silver_casting:need_lightning_rod, false);
+if (inv_total(inv, tiara_mould) > 0) {
+    inv_transmit(silvercast_tiara, silver_casting:slot_tiara);
+    if_sethide(silver_casting:make_tiara, false);
+    if_sethide(silver_casting:need_tiara, true);
+} else {
+    if_sethide(silver_casting:make_tiara, true);
+    if_sethide(silver_casting:need_tiara, false);
+}
+// silvthrill_rod: a quest step with no Crafting level or experience to copy, and nothing
+// in this build hands out its mould, so it stays on the need side by itself.
+if_sethide(silver_casting:make_silvthrill_rod, true);
+if_sethide(silver_casting:need_silvthrill_rod, false);
+// demonic_sigil: a quest step with no Crafting level or experience to copy, and nothing
+// in this build hands out its mould, so it stays on the need side by itself.
+if_sethide(silver_casting:make_demonic_sigil, true);
+if_sethide(silver_casting:need_demonic_sigil, false);
+if_openmain(silver_casting);
+
+[inv_button1,silver_casting:slot_holy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringstar, holy_symbol_mould, 1);
+}
+
+[inv_button2,silver_casting:slot_holy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringstar, holy_symbol_mould, 5);
+}
+
+[inv_button3,silver_casting:slot_holy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringstar, holy_symbol_mould, 10);
+}
+
+[inv_button1,silver_casting:slot_unholy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringsnake, unholy_symbol_mould, 1);
+}
+
+[inv_button2,silver_casting:slot_unholy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringsnake, unholy_symbol_mould, 5);
+}
+
+[inv_button3,silver_casting:slot_unholy_symbol]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(nostringsnake, unholy_symbol_mould, 10);
+}
+
+[inv_button1,silver_casting:slot_silver_sickle]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(silver_sickle, sickle_mould, 1);
+}
+
+[inv_button2,silver_casting:slot_silver_sickle]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(silver_sickle, sickle_mould, 5);
+}
+
+[inv_button3,silver_casting:slot_silver_sickle]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(silver_sickle, sickle_mould, 10);
+}
+
+[inv_button1,silver_casting:slot_tiara]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(tiara, tiara_mould, 1);
+}
+
+[inv_button2,silver_casting:slot_tiara]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(tiara, tiara_mould, 5);
+}
+
+[inv_button3,silver_casting:slot_tiara]
+if (p_finduid(uid) = true) {
+    @silver_casting_go(tiara, tiara_mould, 10);
+}
+
+[label,silver_casting_go](namedobj $product, namedobj $mould, int $count)
+if (inv_total(inv, $mould) < 1) {
+    ~mesbox("You require a mould to make that.");
+    return;
+}
+if_close;
+weakqueue*(silver_casting_run, 0)($product, $count);
+
+// The level, the experience and the name all come off crafting_jewelry_struct, which is
+// the same struct [label,craft_silver] read. The tiara had no struct until this round,
+// because nothing had ever offered to make one.
+[queue,silver_casting_run](namedobj $product, int $count)
+if ($count < 1) {
+    return;
+}
+if (inv_total(inv, silver_bar) < 1) {
+    mes("You need a silver bar to make that.");
+    return;
+}
+def_struct $struct = oc_param($product, crafting_jewelry_struct);
+def_int $level = struct_param($struct, levelrequired);
+if (stat(crafting) < $level) {
+    ~mesbox("You need at least level <tostring($level)> Crafting to make that.");
+    return;
+}
+weakqueue*(silver_casting_run, 3)($product, sub($count, 1));
+anim(human_furnace, 0);
+sound_synth(furnace, 1, 0);
+inv_del(inv, silver_bar, 1);
+inv_add(inv, $product, 1);
+stat_advance(crafting, struct_param($struct, productexp));
+// Confirmed, no period at the end. https://i.imgur.com/sCKRVO9.png
+mes("You make <~add_article(struct_param($struct, name))>");
