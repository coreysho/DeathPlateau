index 80eb8f13..3dca31cc 100644
--- a/scripts/storage_items/scripts/rune_pouch_ui.rs2
+++ b/scripts/storage_items/scripts/rune_pouch_ui.rs2
@@ -13,8 +13,40 @@
 // main overlay. A window component would stop being transmitted the first time you closed the
 // window. An interface that is never opened is never any of those.
 
+// AND THE MIRROR HAS TO FOLLOW THE POUCH. It used to be transmitted once, from login, and never
+// touched again - so the client went on counting the pouch's runes after the pouch had been
+// banked, dropped, traded away or lost on death. Every spell lit up, and every cast was then
+// refused by the server, which checks ~rune_pouch_carried properly. "It says I have the runes and
+// I can't cast anything" is that.
+//
+// This engine has no inventory-change trigger - there is no [inv_changed] to hang it on - so a
+// soft timer asks the question instead, every other tick, and only re-transmits when the answer
+// CHANGES. The cost of a tick that changes nothing is one ~rune_pouch_carried call.
 [proc,rune_pouch_mirror_start]
-inv_transmit(rune_pouch_store, rune_pouch_mirror:runes);
+%rune_pouch_mirrored = false;
+~rune_pouch_mirror_sync;
+softtimer(rune_pouch_mirror_timer, 2);
+
+[softtimer,rune_pouch_mirror_timer]
+~rune_pouch_mirror_sync;
+
+[proc,rune_pouch_mirror_sync]
+def_boolean $carried = false;
+if (~rune_pouch_carried ! null) {
+    $carried = true;
+}
+if ($carried = %rune_pouch_mirrored) {
+    return;
+}
+%rune_pouch_mirrored = $carried;
+if ($carried = true) {
+    inv_transmit(rune_pouch_store, rune_pouch_mirror:runes);
+} else {
+    // An empty inv rather than inv_stoptransmit: stopping leaves the client holding whatever it
+    // last saw, which is the bug. Transmitting an inv that is empty by config makes every count
+    // on the mirror read zero.
+    inv_transmit(rune_pouch_empty, rune_pouch_mirror:runes);
+}
 
 // ---------------------------------------------------------------- the window
 [opheld3,rune_pouch] ~rune_pouch_open;
diff --git a/tools/playfixes_battery.py b/tools/playfixes_battery.py
new file mode 100644
index 00000000..42d1397f
--- /dev/null
+++ b/tools/playfixes_battery.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Checks for the three fixes that came out of a play session on 2026-09-21.
+
+Ancient ice refusing to cast at a frozen target, the rune pouch mirror outliving the pouch, and
+two TzHaar shopkeepers standing the wrong way round.
+
+WHAT EACH GROUP ANCHORS ON, none of it written by this round:
+
+  - magic_combat_spells.dbrow, whose `data=maxhit,-1` on the three pure freezes and real maxhit on
+    every ancient ice spell is the thing that decides which spells may be refused at a frozen target
+  - the OSRS wiki's own sentence about the equipment store being EAST of the ore and gem store
+  - rune_pouch.enum and the engine's command list
+
+    python3 tools/playfixes_battery.py
+"""
+import os, re, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+os.chdir(ROOT)
+FAILED, GROUP = [], ['']
+
+
+def group(t):
+    GROUP[0] = t
+    print(t)
+
+
+def check(cond, msg, extra=''):
+    print('  %s %s%s' % ('ok  ' if cond else 'FAIL', msg, (': ' + str(extra)) if extra != '' else ''))
+    if not cond:
+        FAILED.append('%s / %s' % (GROUP[0], msg))
+
+
+def read(p):
+    return open(p, encoding='utf-8', errors='ignore').read()
+
+
+def nocomment(t):
+    return re.sub(r'//[^\n]*', '', t)
+
+
+PVM = read('scripts/skill_combat/scripts/player/player_magic.rs2')
+PVP = read('scripts/skill_combat/scripts/pvp/pvp_magic.rs2')
+MAGIC = read('scripts/skill_magic/scripts/magic.rs2')
+SPELLS = read('scripts/skill_combat/configs/magic/magic_combat_spells.dbrow')
+
+
+def rows(text):
+    out = {}
+    for b in re.split(r'\n(?=\[)', text):
+        m = re.match(r'\[(\w+)\]', b)
+        if m:
+            out[m.group(1)] = dict(re.findall(r'^data=(\w+),(.*)$', b, re.M))
+    return out
+
+
+R = rows(SPELLS)
+
+# ---------------------------------------------------------------- 1
+group('1. which spells are nothing but their freeze, according to the table')
+frozen = {k: v for k, v in R.items() if int(v.get('freeze_time', 0) or 0) > 0}
+check(len(frozen) >= 7, 'rows with a freeze_time', len(frozen))
+pure = {k for k, v in frozen.items() if int(v.get('maxhit', 0)) < 0}
+dmg = {k for k, v in frozen.items() if int(v.get('maxhit', 0)) >= 0}
+check(pure == {'magic_combat_bind', 'magic_combat_snare', 'magic_combat_entangle'},
+      'exactly three carry maxhit,-1 - bind, snare and entangle', sorted(pure))
+check(all('ice' in k for k in dmg),
+      'and every other freezing spell is an ice spell with a real maxhit', sorted(dmg))
+# ONE CONSTANT WORDING, offenders appended. A message built from the data cannot be a mutation
+# label, because tools/mutate_labels.py reads a CLEAN run and a per-row message that only exists
+# once something is broken matches nothing. Third round in a row this rule has been needed.
+weak = sorted(k for k in dmg if int(R[k]['maxhit']) <= 0)
+check(not weak, 'every ice spell that freezes also does real damage',
+      weak or '%d of them' % len(dmg))
+check('[proc,magic_spell_is_pure_freeze]' in MAGIC,
+      'and one proc answers the question for both PvM and PvP', 'yes')
+pf = nocomment(MAGIC).split('[proc,magic_spell_is_pure_freeze]', 1)[1].split('\n[', 1)[0]
+check('magic_spell_table:maxhit' in pf,
+      '...by reading that maxhit rather than a list of spell names', 'yes')
+
+# ---------------------------------------------------------------- 2
+group('2. a damaging ice spell is no longer refused at a frozen target')
+for name, src in (('PvM', PVM), ('PvP', PVP)):
+    body = nocomment(src).split('_freeze_allowed]', 1)[1].split('\n[', 1)[0]
+    check('~magic_spell_is_pure_freeze' in body,
+          '%s: the already-held refusal is gated on the spell being a pure freeze' % name, 'yes')
+    check('already held by a magical force' in body,
+          '%s: and the message itself is still there for bind, snare and entangle' % name, 'yes')
+# Two CALL sites - the primary target and the secondary ones. The definition is [proc,...] and
+# carries no ~, so two is the whole of it.
+check(nocomment(PVM).count('~pvm_freeze_lands') == 2,
+      'PvM asks one proc whether the freeze lands, from both the primary and the secondary path',
+      nocomment(PVM).count('~pvm_freeze_lands'))
+check(nocomment(PVP).count('~pvp_freeze_lands') == 2,
+      'PvP does the same', nocomment(PVP).count('~pvp_freeze_lands'))
+for name, src, var in (('PvM', PVM, '%npc_stunned'), ('PvP', PVP, '.%frozen')):
+    body = nocomment(src).split('_freeze_lands]', 1)[1].split('\n[', 1)[0]
+    check('+ 5' in body, '%s: and that proc honours the five-tick immunity, not just the freeze'
+          % name, 'yes')
+    check(var in body, '%s: reading %s' % (name, var), 'yes')
+for name, src in (('PvM', PVM), ('PvP', PVP)):
+    calls = re.findall(r'~(pv[mp])_freeze_effect\(', nocomment(src))
+    guarded = len(re.findall(r'if \(~pv[mp]_freeze_lands = true\) \{\n\s*~pv[mp]_freeze_effect',
+                             nocomment(src)))
+    check(guarded == 2, '%s: both freeze_effect call sites are guarded' % name, guarded)
+
+# ---------------------------------------------------------------- 3
+group('3. the rune pouch mirror follows the pouch')
+UI = read('scripts/storage_items/scripts/rune_pouch_ui.rs2')
+check('[softtimer,rune_pouch_mirror_timer]' in UI, 'a soft timer keeps it honest', 'yes')
+check('softtimer(rune_pouch_mirror_timer, 2)' in nocomment(UI), 'every two ticks', 'yes')
+check('~rune_pouch_carried' in nocomment(UI),
+      'and it asks the same question the server-side rune count asks', 'yes')
+sync = nocomment(UI).split('[proc,rune_pouch_mirror_sync]', 1)[1].split('\n[', 1)[0]
+check('inv_transmit(rune_pouch_store, rune_pouch_mirror:runes);' in sync,
+      'carried: the store is mirrored', 'yes')
+check('inv_transmit(rune_pouch_empty, rune_pouch_mirror:runes);' in sync,
+      'not carried: an inv that is empty by config is mirrored instead', 'yes')
+check('inv_stoptransmit' not in sync,
+      'and NOT inv_stoptransmit, which would leave the client holding its last copy', 'yes')
+check('%rune_pouch_mirrored' in sync and 'return;' in sync,
+      'it re-transmits only when the answer changes', 'yes')
+varp = nocomment(read('scripts/storage_items/configs/rune_pouch.varp'))
+mir = varp.split('[rune_pouch_mirrored]', 1)[1] if '[rune_pouch_mirrored]' in varp else ''
+check('type=boolean' in mir, 'the varp is type=boolean, because the script reads it as one', 'yes')
+check('scope=temp' in mir and 'protect=no' in mir, 'scope=temp protect=no', 'yes')
+inv = read('scripts/storage_items/configs/rune_pouch.inv')
+empty = inv.split('[rune_pouch_empty]', 1)[1] if '[rune_pouch_empty]' in inv else ''
+check('stock' not in empty, 'rune_pouch_empty really is empty - no stock lines', 'yes')
+packs = {k: set(l.strip().split('=', 1)[1] for l in open('pack/%s.pack' % k)) for k in ('inv', 'varp')}
+check('rune_pouch_empty' in packs['inv'], 'and it is packed', 'yes')
+check('rune_pouch_mirrored' in packs['varp'], 'as is the varp', 'yes')
+
+# ---------------------------------------------------------------- 4
+group('4. the two Hur shopkeepers, the way the wiki orders them')
+npcpack = {}
+for l in open('pack/npc.pack'):
+    i, n = l.strip().split('=', 1)
+    npcpack[n] = i
+spawns = {}
+for line in read('maps/m38_80.jm2').split('\n'):
+    m = re.match(r'^0 (\d+) (\d+): (\d+)$', line.strip())
+    if m:
+        spawns.setdefault(m.group(3), []).append((int(m.group(1)), int(m.group(2))))
+who = {}
+for key, label in (('tzhaar_shopkeeper_equipment', 'equipment'),
+                   ('tzhaar_shopkeeper_oreandgem', 'oreandgem'),
+                   ('tzhaar_shopkeeper_rune', 'rune')):
+    i = npcpack.get(key)
+    check(i is not None, '%s has an npc id' % key, i)
+    check(len(spawns.get(i, [])) == 1, 'and is spawned exactly once in m38_80',
+          len(spawns.get(i, [])))
+    if spawns.get(i):
+        who[label] = spawns[i][0]
+# https://oldschool.runescape.wiki/w/TzHaar-Hur-Tel's_Equipment_Store - "It is located east of
+# TzHaar-Hur-Lek's Ore and Gem Store." x increases east, so Tel's x must be the greater.
+check(who.get('equipment', (0, 0))[0] > who.get('oreandgem', (0, 0))[0],
+      "the equipment store is EAST of the ore and gem store, which is the one thing the wiki states",
+      '%s vs %s' % (who.get('equipment'), who.get('oreandgem')))
+check(len(set(who.values())) == 3, 'and no two of the three stand on the same tile', sorted(who.values()))
+
+print()
+if FAILED:
+    print('%d FAILED' % len(FAILED))
+    for f in FAILED:
+        print('  ' + f)
+    sys.exit(1)
+print('ALL PASS')
