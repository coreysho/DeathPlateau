+#!/usr/bin/env python3
+"""Break the three play-session fixes on purpose and check the right check goes red.
+
+Anchors are asserted unique before they are applied, labels are the CHECK's wording, and the run
+reports which check actually fired - the three rules every harness in this repo follows.
+
+    python3 tools/playfixes_mutate.py
+"""
+import os, shutil, subprocess, sys, tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+W = os.path.join(tempfile.gettempdir(), 'playfixes_mutate_work')
+
+PVM = 'scripts/skill_combat/scripts/player/player_magic.rs2'
+PVP = 'scripts/skill_combat/scripts/pvp/pvp_magic.rs2'
+MAG = 'scripts/skill_magic/scripts/magic.rs2'
+UI = 'scripts/storage_items/scripts/rune_pouch_ui.rs2'
+VARP = 'scripts/storage_items/configs/rune_pouch.varp'
+INV = 'scripts/storage_items/configs/rune_pouch.inv'
+MAP = 'maps/m38_80.jm2'
+DBR = 'scripts/skill_combat/configs/magic/magic_combat_spells.dbrow'
+
+MUTS = [
+    # Replacing the row's OWN maxhit line, not inserting one: the battery reads the block into a
+    # dict, so a second data=maxhit earlier in the block is simply overwritten by the real one and
+    # the mutation does nothing. Anchored with the line above it, which is unique per row.
+    (DBR, 'data=experience,3000\ndata=maxhit,-1', 'data=experience,3000\ndata=maxhit,1',
+     'exactly three carry maxhit,-1 - bind, snare and entangle'),
+    (DBR, 'data=experience,5200\ndata=maxhit,30', 'data=experience,5200\ndata=maxhit,0',
+     'every ice spell that freezes also does real damage'),
+    (MAG, 'db_getfield($spell_data, magic_spell_table:maxhit, 0) < 0',
+     'db_getfield($spell_data, magic_spell_table:spell, 0) < 0',
+     '...by reading that maxhit rather than a list of spell names'),
+    (PVM, '    if (~magic_spell_is_pure_freeze($spell_data) = true) {\n        if (%npc_stunned > map_clock) {',
+     '    if (true = true) {\n        if (%npc_stunned > map_clock) {',
+     'PvM: the already-held refusal is gated on the spell being a pure freeze'),
+    (PVP, '    if (~magic_spell_is_pure_freeze($spell_data) = true) {\n        if (.%frozen > map_clock) {',
+     '    if (true = true) {\n        if (.%frozen > map_clock) {',
+     'PvP: the already-held refusal is gated on the spell being a pure freeze'),
+    # Anchored on the comment above each call, because the two call sites are otherwise identical
+    # text and str.replace would take the first one - the uniqueness rule, met again.
+    (PVM, '    // The primary target gets the same rule the secondary ones always had: the damage lands\n'
+          '    // either way, and the freeze only takes if the target is free of one.\n'
+          '    if (~pvm_freeze_lands = true) {\n        ~pvm_freeze_effect($spell_data);\n    }',
+     '    ~pvm_freeze_effect($spell_data);',
+     'PvM: both freeze_effect call sites are guarded'),
+    (PVP, '    // as in PvM: the damage lands either way, the freeze only if the target is free of one\n'
+          '    if (~pvp_freeze_lands = true) {\n        ~pvp_freeze_effect($spell_data);\n    }',
+     '    ~pvp_freeze_effect($spell_data);',
+     'PvP: both freeze_effect call sites are guarded'),
+    (PVM, 'if (calc(%npc_stunned + 5) <= map_clock) {', 'if (%npc_stunned <= map_clock) {',
+     'PvM: and that proc honours the five-tick immunity, not just the freeze'),
+    (PVP, 'if (calc(.%frozen + 5) <= map_clock) {', 'if (.%frozen <= map_clock) {',
+     'PvP: and that proc honours the five-tick immunity, not just the freeze'),
+    (UI, 'softtimer(rune_pouch_mirror_timer, 2);', 'softtimer(rune_pouch_mirror_timer, 3);',
+     'every two ticks'),
+    (UI, 'inv_transmit(rune_pouch_empty, rune_pouch_mirror:runes);',
+     'inv_stoptransmit(rune_pouch_mirror:runes);',
+     'not carried: an inv that is empty by config is mirrored instead'),
+    (UI, 'if (~rune_pouch_carried ! null) {', 'if (~rune_pouch_slots > 0) {',
+     'and it asks the same question the server-side rune count asks'),
+    (UI, 'if ($carried = %rune_pouch_mirrored) {\n    return;\n}', '',
+     'it re-transmits only when the answer changes'),
+    (VARP, '[rune_pouch_mirrored]\ntype=boolean', '[rune_pouch_mirrored]',
+     'the varp is type=boolean, because the script reads it as one'),
+    (INV, '[rune_pouch_empty]\nsize=1', '[rune_pouch_empty]\nsize=1\nstock0=airrune,1,0',
+     'rune_pouch_empty really is empty - no stock lines'),
+    (MAP, '0 6 53: 3942', '0 1 53: 3942',
+     'the equipment store is EAST of the ore and gem store, which is the one thing the wiki states'),
+    (MAP, '0 9 48: 3944', '0 3 50: 3944',
+     'and no two of the three stand on the same tile'),
+]
+
+
+def run(entry):
+    path, find, repl, label = entry
+    if os.path.exists(W):
+        shutil.rmtree(W)
+    shutil.copytree(ROOT, W, ignore=shutil.ignore_patterns('.git', '__pycache__', 'data'))
+    p = os.path.join(W, path)
+    t = open(p, encoding='utf-8').read()
+    n = t.count(find)
+    if n != 1:
+        return 'SKIP', 'anchor appears %d times, not once' % n
+    open(p, 'w', encoding='utf-8').write(t.replace(find, repl, 1))
+    r = subprocess.run([sys.executable, os.path.join(W, 'tools', 'playfixes_battery.py')],
+                       cwd=W, capture_output=True, text=True)
+    if r.returncode == 0:
+        return 'GREEN', 'the battery still passed'
+    fired = [l.strip()[5:].strip() for l in r.stdout.split('\n') if l.strip().startswith('FAIL')]
+    if any(f == label or f.startswith(label + ':') for f in fired):
+        return 'red', 'caught by its own check'
+    if fired:
+        return 'OTHER', 'caught by %r instead' % fired[0]
+    return 'CRASH', (r.stderr.strip().split('\n') or [''])[-1][:90]
+
+
+def main():
+    bad = 0
+    for e in MUTS:
+        state, why = run(e)
+        if state != 'red':
+            bad += 1
+        print('  %-6s %-62s %s' % (state, e[3][:62], why))
+    print()
+    if bad:
+        print('%d of %d mutations were not caught by the check they name' % (bad, len(MUTS)))
+        sys.exit(1)
+    print('every mutation was caught, each by its own check')
+
+
+if __name__ == '__main__':
+    main()
