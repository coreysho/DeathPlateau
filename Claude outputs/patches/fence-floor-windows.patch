+// Fencing, the throne room floor and the chapel windows.
+//
+// GENERATED by tools/gendecor.py from the six template squares and tools/furnspec.json.
+// Do not edit by hand. Each of the three is one piece over several tiles, so each goes
+// through the "show" hand-off and an anchor, the way the combat ring and the rugs do, and
+// each shares their rotation maths - ~poh_ring_tile and ~poh_ring_angle in
+// poh_combat_ring.rs2, which are the engine's own zone arithmetic.
+//
+// THE ANCHOR IS IN furnspec.json AND NOWHERE ELSE. The click reads it there and the numbers
+// below are written from it, so the two cannot drift - which is the mistake the rug round
+// left open and a mutation caught.
+
+// =========================================================================== the fence
+
+// Seven tiers, one loc each, over the garden's twenty perimeter tiles - sixteen straight and
+// four corners, which is why there are two helpers: the shape picks the LAYER a loc goes on.
+[proc,poh_fence_loc](int $tier)(loc)
+switch_int ($tier) {
+    case 1 : return(loc_13449);
+    case 2 : return(loc_13450);
+    case 3 : return(loc_13451);
+    case 4 : return(loc_13452);
+    case 5 : return(loc_13453);
+    case 6 : return(loc_13454);
+    case 7 : return(loc_13455);
+    case default : return(null);
+}
+
+[proc,poh_fence_wall](coord $base, int $rot, int $x, int $z, int $angle, int $tier)
+loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_fence_loc($tier), ~poh_ring_angle($angle, $rot), wall_straight, ^poh_loc_duration);
+
+[proc,poh_fence_corner](coord $base, int $rot, int $x, int $z, int $angle, int $tier)
+loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_fence_loc($tier), ~poh_ring_angle($angle, $rot), wall_l, ^poh_loc_duration);
+
+[proc,poh_fence_place](coord $spot, int $angle, int $tier)
+def_coord $base = movecoord($spot, -1, 0, -3);
+def_int $rot = ~poh_ring_room_rot($base);
+~poh_fence_corner($base, $rot, 0, 0, 3, $tier);
+~poh_fence_wall($base, $rot, 0, 1, 0, $tier);
+~poh_fence_wall($base, $rot, 0, 2, 0, $tier);
+~poh_fence_wall($base, $rot, 0, 5, 0, $tier);
+~poh_fence_wall($base, $rot, 0, 6, 0, $tier);
+~poh_fence_corner($base, $rot, 0, 7, 0, $tier);
+~poh_fence_wall($base, $rot, 1, 0, 3, $tier);
+~poh_fence_wall($base, $rot, 1, 7, 1, $tier);
+~poh_fence_wall($base, $rot, 2, 0, 3, $tier);
+~poh_fence_wall($base, $rot, 2, 7, 1, $tier);
+~poh_fence_wall($base, $rot, 5, 0, 3, $tier);
+~poh_fence_wall($base, $rot, 5, 7, 1, $tier);
+~poh_fence_wall($base, $rot, 6, 0, 3, $tier);
+~poh_fence_wall($base, $rot, 6, 7, 1, $tier);
+~poh_fence_corner($base, $rot, 7, 0, 2, $tier);
+~poh_fence_wall($base, $rot, 7, 1, 2, $tier);
+~poh_fence_wall($base, $rot, 7, 2, 2, $tier);
+~poh_fence_wall($base, $rot, 7, 5, 2, $tier);
+~poh_fence_wall($base, $rot, 7, 6, 2, $tier);
+~poh_fence_corner($base, $rot, 7, 7, 1, $tier);
+
+[proc,poh_fence_remove]
+~poh_decor_remove(1, 3);
+
+// =========================================================================== the throne floor
+
+// One tier - OSRS's other four are a steel cage, a trapdoor and two magic cages, and all of
+// them drop the loser into an oubliette this one-storey build does not have. The ART is your
+// house style's: six floor decorations, one per style, named after the same six towns the
+// windows are.
+[proc,poh_thronefloor_loc](int $style)(loc)
+switch_int ($style) {
+    case 0 : return(poh_floordecor_rimmington);   // rimmington
+    case 1 : return(poh_floordecor_lumbridge);   // lumbridge
+    case 2 : return(poh_floordecor_pollnivneach);   // pollnivneach
+    case 3 : return(poh_floordecor_rellekka);   // rellekka
+    case 4 : return(poh_floordecor_brimhaven);   // brimhaven
+    case 5 : return(poh_floordecor_yanille);   // yanille
+    case default : return(poh_floordecor_rimmington);
+}
+
+[proc,poh_thronefloor_mat](coord $base, int $rot, int $x, int $z, int $angle)
+loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_thronefloor_loc(%poh_style), ~poh_ring_angle($angle, $rot), grounddecor, ^poh_loc_duration);
+
+[proc,poh_thronefloor_place](coord $spot, int $angle, int $tier)
+def_coord $base = movecoord($spot, 0, 0, -6);
+def_int $rot = ~poh_ring_room_rot($base);
+~poh_thronefloor_mat($base, $rot, 3, 3, 3);
+~poh_thronefloor_mat($base, $rot, 3, 4, 0);
+~poh_thronefloor_mat($base, $rot, 4, 3, 2);
+~poh_thronefloor_mat($base, $rot, 4, 4, 1);
+
+[proc,poh_thronefloor_remove]
+~poh_decor_remove(0, 6);
+
