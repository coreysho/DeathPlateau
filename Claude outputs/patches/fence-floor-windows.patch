+    case 25 : return(poh_pollnivneach_window_guthix2);
+    case 26 : return(poh_pollnivneach_window_zamorak2);
+    case 27 : return(poh_rellekka_window_shutters);
+    case 28 : return(poh_rellekka_window_bob);
