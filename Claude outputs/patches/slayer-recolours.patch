+    case 8 : $bit = 5; $cost = 1000; $what = "Use an abyssal head on a slayer helmet to make it red. Abyssal demons drop the head.";
+    case 9 : $bit = 6; $cost = 1000; $what = "Use a Kq head on a slayer helmet to make it green. The Kalphite Queen drops the head.";
