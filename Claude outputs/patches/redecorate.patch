+[debugproc,pohtown](int $town)
+if (p_finduid(uid) = true) {
+    switch_int ($town) {
+        case 0 : p_telejump(0_46_50_9_24);   mes("Rimmington - the portal that is already there.");
+        case 1 : p_telejump(0_45_53_17_57);  mes("Taverley - 2897,3449, east of the town on the path. Try ::~pohportal 0.");
+        case 2 : p_telejump(0_52_46_12_59);  mes("Pollnivneach - 3340,3003, the OSRS tile itself. Try ::~pohportal 0.");
+        case 3 : p_telejump(0_41_56_45_52);  mes("Rellekka - 2669,3636, six north of the OSRS tile. Try ::~pohportal 0.");
+        case 4 : p_telejump(0_43_49_9_49);   mes("Brimhaven - 2761,3185, north east of the OSRS tile. Try ::~pohportal 0.");
+        case 5 : p_telejump(0_39_48_44_22);  mes("Yanille - 2540,3094, four west of the OSRS tile. Try ::~pohportal 1.");
+        case default : mes("Towns are 0 Rimmington, 1 Taverley, 2 Pollnivneach, 3 Rellekka, 4 Brimhaven, 5 Yanille.");
+    }
+}
diff --git a/tools/poh_battery.py b/tools/poh_battery.py
