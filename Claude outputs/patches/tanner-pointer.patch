@@ -0,0 +1,16 @@
+// WHICH TANNER YOU ARE STANDING IN FRONT OF, REMEMBERED FROM WHEN THE WINDOW OPENED.
+//
+// Canifis charges 2/5/45 and Al Kharid 1/3/20, so the window has to know which npc opened it. The
+// obvious way to ask is npc_type - and that needs the active_npc pointer, which an [opnpc3,...]
+// trigger has and an [if_button,...] trigger does NOT. The build says so, at the call site, on all
+// 32 buttons:
+//
+//     ERROR: Attempt to access uninitialized pointer [ 'active_npc' ].
+//
+// So the question is asked once, in ~tan_window_open, where the npc is still in scope, and the
+// answer is kept here. scope=temp because it means nothing between sessions; protect=no because
+// [if_button] reads it. skill_guide.varp and game_options.varp carry the same pair for the same
+// reason and say so in their own comments.
+[tan_window_canifis]
+scope=temp
+protect=no
diff --git a/scripts/skill_crafting/scripts/leather/tan_window.rs2 b/scripts/skill_crafting/scripts/leather/tan_window.rs2
index c9ab99c5..3e441d33 100644
--- a/scripts/skill_crafting/scripts/leather/tan_window.rs2
+++ b/scripts/skill_crafting/scripts/leather/tan_window.rs2
@@ -17,9 +17,16 @@
 [opnpc3,ellis_tanner]
 ~tan_window_open;
 
-// Fill the cells this build can tan, hide the rest.
+// ASK WHICH TANNER HERE, NOT IN A BUTTON. npc_type needs the active_npc pointer. An
+// [opnpc3,...] trigger has it; an [if_button,...] trigger does not, and the build says
+// so on all 32 buttons at once. So the question is asked once, while the npc is still
+// in scope, and the answer lives in %tan_window_canifis until the window closes.
 [proc,tan_window_open]
 def_int $cost;
+%tan_window_canifis = false;
+if (npc_type = werewolftanner) {
+    %tan_window_canifis = true;
+}
 if_sethide(tan_window:cell1, false);
 if_setobject(tan_window:hide1, cow_hide, ^tan_window_scale);
 if_settext(tan_window:name1, "Soft leather");
@@ -63,9 +70,10 @@ if_sethide(tan_window:cell8, true);
 if_openmain(tan_window);
 
 // Which tanner's prices. Canifis is not a markup on Al Kharid - it is 2/5/45 against
-// 1/3/20 - so both constants are read and the npc in front of you picks.
+// 1/3/20 - so both constants are read and the tanner that opened the window picks.
+// This reads the varp and NOT npc_type, because the buttons reach it with no npc.
 [proc,tan_window_cost](int $al_kharid, int $canifis)(int)
-if (npc_type = werewolftanner) {
+if (%tan_window_canifis = true) {
     return($canifis);
 }
 return($al_kharid);
