+// the orange every button in these windows is drawn in, for putting a row back after it was white
+^tp_orange = 0xFF981F
diff --git a/scripts/tradingpost/configs/tradingpost.inv b/scripts/tradingpost/configs/tradingpost.inv
new file mode 100644
index 000000000..ce27266a4
--- /dev/null
+++ b/scripts/tradingpost/configs/tradingpost.inv
@@ -0,0 +1,38 @@
+// THE TRADING POST'S INVS. Every one is temp: the market itself lives in the engine's database
+// (engine/src/engine/market/TradingPost.ts), and these are only what a window shows.
+//
+// The four DISPLAY invs are written by tp_* commands one slot at a time - one listing per slot, in
+// order - so two listings of the same thing are two slots, and nothing here stacks them together.
+// protect=no because the if_close handlers that clear them run without protected access.
+
+// a page of listings: the lists window's 8 x 4 grid
+[tp_view]
+size=32
+stackall=yes
+protect=no
+
+// the one item on the listing window
+[tp_item]
+size=1
+stackall=yes
+protect=no
+
+// what is in the offer the seller has picked: coins first, then up to twelve items
+[tp_offerview]
+size=13
+stackall=yes
+protect=no
+
+// what the player is owed
+[tp_box]
+size=32
+stackall=yes
+protect=no
+
+// THE BARTER INV, where an offer's items wait while it is being built. The only one of these that
+// holds real items: [if_close,tradingpost_offer] hands them back, and tp_makeoffer takes them all.
+// protect=no for the same reason tradeoffer is - if_close runs unprotected, and it must be able
+// to empty this back into the inventory whatever closed the window.
+[tp_barter]
+size=12
+protect=no
diff --git a/scripts/tradingpost/configs/tradingpost.loc b/scripts/tradingpost/configs/tradingpost.loc
new file mode 100644
index 000000000..1a819b869
--- /dev/null
+++ b/scripts/tradingpost/configs/tradingpost.loc
@@ -0,0 +1,19 @@
+// THE TRADING POST. The model is built by tools/models/gentradingpostmodel.py: a notice board of
+// listings, a strongbox for the collection box, and a crate of coins. Two tiles wide.
+//
+// It faces SOUTH at angle 0 - the notices, the strongbox and the approach are all on that side -
+// and forceapproach turns with the loc, so a post placed at any angle is used from its front.
+// Edgeville's is at angle 3, facing east across the road to the bank door.
+[trading_post]
+name=Trading post
+desc=Goods for sale, pinned up by other players. The strongbox holds what you're owed.
+model=trading_post
+width=2
+length=1
+forceapproach=south
+blockrange=no
+ambient=25
+contrast=125
+op1=Browse
+op2=Sell
+op3=Collect
diff --git a/scripts/tradingpost/configs/tradingpost.varp b/scripts/tradingpost/configs/tradingpost.varp
new file mode 100644
index 000000000..da8110390
--- /dev/null
+++ b/scripts/tradingpost/configs/tradingpost.varp
@@ -0,0 +1,40 @@
+// THE TRADING POST'S WINDOW STATE. All temp: which tab, which page, which listing and offer are
+// open, and the coins in an offer being built. Nothing about the market itself is a varp.
+//
+// protect=no on all of them: [if_button] triggers have no p_active_player, and writing a protected
+// varp needs one - see interfaces/configs/skill_guide.varp.
+
+// ^tp_tab_browse / _mine / _offers / _box
+[tp_tab]
+scope=temp
+protect=no
+
+[tp_page]
+scope=temp
+protect=no
+
+// the listing on the listing window, and the offer picked on it (-1 = none)
+[tp_listing]
+scope=temp
+protect=no
+
+[tp_offer]
+scope=temp
+protect=no
+
+// the coins in the offer being built
+[tp_coins]
+scope=temp
+protect=no
+
+// A SECOND CLICK TO BUY. Buy now, Accept and Take down are the three buttons that cannot be undone,
+// so the first click arms this with what it would do and says so, and only the same button
+// clicked again does it. Anything else the player clicks disarms it.
+[tp_confirm]
+scope=temp
+protect=no
+
+// ^tp_window_lists / _listing / _offer
+[tp_window]
+scope=temp
+protect=no
