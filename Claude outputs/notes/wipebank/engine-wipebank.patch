 .../client/handler/ClientCheatCommands.ts     |   1 +
 .../game/client/handler/ClientCheatHandler.ts |  37 +++
 tools/sim/wipebank.ts                         | 246 ++++++++++++++++++
 3 files changed, 284 insertions(+)
