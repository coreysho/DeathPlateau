 // chest is looted rather than out of his own box. %barrows_entry_crypt holds his bit PLUS ONE so
@@ -165,3 +170,51 @@
 ^barrows_tele_low = 4
 ^barrows_tele_high = 6
 ^barrows_tele_dest = 0_55_51_45_48
+
+// =============================================================================================
+// THE BROTHERS' OWN SET EFFECTS, AND THE PRAYER DRAIN
