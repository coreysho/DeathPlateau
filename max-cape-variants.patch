+ "recolours": {
+  "_what": "The god variants have no models of their own - they recolour the plain Max cape's and the max hood's. This records what the recolour sources actually hit, because a source that hits nothing makes the piece render as a plain Max cape and NOTHING else notices: not the config, not the linter, not the packed-data check.",
+  "conversion_is_colour_exact": {
+   "_finding": "This build's converted models are colour-identical to OSRS's. Checked by decoding the OSRS models straight out of index 7 and comparing face counts and colour sets with the .ob2 files osrs2ob2.py produced.",
+   "face_counts": {
+    "max_hood": 416,
+    "max_hood_manwear": 504,
+    "max_hood_womanwear": 477,
+    "max_hood_manhead": 698,
+    "max_hood_womanhead": 698,
+    "max_cape": 646,
+    "max_cape_manwear": 642,
+    "max_cape_womanwear": 640
+   },
+   "_face_counts": "Identical on both sides, model for model. This is what makes the recolour sources - which are OSRS's numbers for OSRS's models - valid against ours."
+  },
+  "sources_present": {
+   "max_cape": [
+    668,
+    675,
+    784,
+    815,
+    673
+   ],
+   "max_hood": [
+    675,
+    784,
+    815,
+    685
+   ]
+  },
+  "inert_in_osrs_too": {
+   "pairs": [
+    668,
+    673
+   ],
+   "on": "every max hood model",
+   "_why": "The hood's six-pair recolour list is the cape's five pairs with 685 appended - same five sources, same order. Two of those five (668 and 673) exist on the cape's models and on no hood model, so those two pairs do nothing on a hood. Verified to be true of OSRS's own models as well, not an artefact of importing: 29629, 29614, 29623, 29626 and 29628 carry 675, 784, 815 and 685 and neither 668 nor 673.",
+   "_kept": "The pairs are kept rather than trimmed, because the spec's job is to say what OSRS's item table says. tools/maxvariantrender.py asserts exactly this pattern, so a recolour that SHOULD bite and stops biting goes red while these two stay quiet."
+  }
+ },
+ "textures": {
+  "_what": "The two variants with models of their own carry textured faces; the other fourteen have none. Recorded because a texture that did not survive the import is the exact bug the Infernal cape round was about.",
+  "fire_max_cape": {
+   "obj_fire_max_cape": {
+    "31": 54
+   },
+   "obj_fire_max_cape_manwear": {
+    "40": 108
+   },
+   "obj_fire_max_cape_womanwear": {
+    "40": 104,
+    "31": 4
+   }
+  },
+  "infernal_max_cape": {
+   "obj_infernal_max_cape": {
+    "50": 126
+   },
+   "obj_infernal_max_cape_manwear": {
+    "50": 126
+   },
+   "obj_infernal_max_cape_womanwear": {
+    "50": 126
+   }
+  },
+  "_fire": "OSRS 31 and 40, both in osrs2ob2.SHARED_TEXTURES - pixel-identical to the 377 texture of the same id, compared in an earlier round - so they came through at their own ids. 40 is the animated lava the Fire cape itself wears, which is the reassuring part: the variant and its source cape are textured the same way.",
+  "_infernal": "OSRS 59 -> local 50, through osrs2ob2.LOCAL_TEXTURES. That map was written in the Infernal cape round precisely so the next import of anything using texture 59 would keep it without anyone remembering; this is that next import, and it worked with no intervention.",
+  "_hoods": "Neither the fire nor the infernal hood has a textured face, and the god variants wear the plain max cape's models, which have none either. So fourteen of the sixteen are flat-shaded and fully judgeable from a render.",
+  "_render_limit": "tools/ob2render.py draws a textured face as flat grey shaded by its own lightness - deliberately, and its comment says so: skipping them would hide the model. So in the contact sheet the fire and infernal CAPES show a true silhouette and a false surface, and their 54 and 126 textured faces cannot be judged offline at all. Same caveat the Infernal cape carried."
+ },
+ "noticed_not_fixed": {
+  "texture_pack_names": "pack/texture.pack calls id 40 'jungleleaf4' and id 31 'lava', and content/textures/jungleleaf4.png has the same average colour as lava.png - (247, 144, 46) for both, and they are different files. So whatever id 40 is, it is not jungle leaves, and the Fire cape has always worn it. The NAMES in texture.pack do not reliably describe the images. Not touched here: renaming a pack entry is a cache-wide change and this round has no business making it. Noted for the backlog."
+ },
+ "a_finding_of_mine_that_was_wrong": {
+  "_claim": "That tzhaar_cape_fire and tzhaar_cape_infernal were each missing param=rangeattack,1, and that this round fixed it.",
+  "_truth": "Both already had it. Nothing was missing and nothing needed fixing.",
+  "_how": "The survey that produced the claim grepped the configs with param=(stab|slash|crush|magic|ranged|attack|defence|str|prayer) - and 'ranged' does not match 'rangeattack', while 'attack' only matches at the start of the value. So the regex could not see rangeattack on ANY record, and its absence from the output was read as its absence from the file.",
+  "_caught_by": "tools/fightcave_battery.py, which pins the Infernal cape at exactly the bonuses its own spec names and counts them. Adding a duplicate rangeattack line made it thirteen and the count went red. The per-param checks above it had been printing 'param rangeattack is the cache's 1' as OK the whole time, which is the line that should have been read before believing the grep.",
+  "_lesson": "A negative result from a hand-written regex is not evidence. The parser the battery already has - blocks() into {key: [values]} - answers the same question exactly, and is what the derived-from-source check in group 13 uses."
+ }
+}
diff --git a/tools/maxvariantrender.py b/tools/maxvariantrender.py
new file mode 100644
index 00000000..e394862b
--- /dev/null
+++ b/tools/maxvariantrender.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Render the sixteen Max cape variant pieces, and prove their recolours actually bite.
+
+THE CHECK THIS EXISTS FOR. Twelve of the sixteen have no model of their own: they are the plain
+Max cape's model with a recolour list taken from the OSRS item table. That list names SOURCE
+COLOURS on OSRS's model - and this build's model is a re-encoding of it. If the re-encoding moved
+a colour, every recolour would silently match nothing, all six god capes would render as a plain
+Max cape, and no config, no linter and no packed-data check would notice. Nothing would look
+broken; it would look like the wrong cape.
+
+So this reads each recolour pair out of the GENERATED config, applies it through ob2render's own
+Model.recolour - the same rgb15 -> hsl16 path ObjConfig.ts uses - and counts the faces it hits.
+
+TWO PAIRS ARE MEANT TO HIT NOTHING, and finding that out is why this file exists. A hood's
+six-pair list is the cape's five pairs with one appended - the same five sources, in order - and
+two of those five (hsl16 668 and 673) are colours of the cape and of no hood model. So they do
+nothing on a hood, in OSRS exactly as here: the OSRS models were decoded out of index 7 and carry
+the same face counts and the same colour sets as the converted ones, which is also the evidence
+that the conversion did not move a colour at all. Those two are listed in the spec under
+recolours.inert_in_osrs_too and are expected to miss. Every OTHER source missing is an error.
+
+    python3 tools/maxvariantrender.py                      # check only
+    python3 tools/maxvariantrender.py out.png              # check, and write a contact sheet
+"""
+import json, os, re, sys
+
+C = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(C, 'tools'))
+OBJ = os.path.join(C, 'scripts', 'skillcapes', 'configs', 'max_cape_variants.obj')
+MDIR = os.path.join(C, 'models', 'obj')
+
+
+def records(text):
+    """[(local, {key: [values]})] for every block in the generated .obj."""
+    out = []
+    cur = None
+    for line in text.replace('\r\n', '\n').split('\n'):
+        line = line.split('//')[0].strip()
+        if not line:
+            continue
+        m = re.match(r'^\[(\w+)\]$', line)
+        if m:
+            cur = (m.group(1), {})
+            out.append(cur)
+        elif cur and '=' in line:
+            k, v = line.split('=', 1)
+            cur[1].setdefault(k, []).append(v)
+    return out
+
+
+def main():
+    out_png = sys.argv[1] if len(sys.argv) > 1 else None
+    if not os.path.exists(OBJ):
+        print('no %s - run tools/genmaxvariants.py first' % os.path.relpath(OBJ, C))
+        return 2
+    import ob2render
+    spec = json.load(open(os.path.join(C, 'tools', 'maxcapevariantspec.json')))
+    global INERT
+    INERT = spec['recolours']['inert_in_osrs_too']['pairs']
+
+    recs = records(open(OBJ, newline='').read())
+    if len(recs) != 16:
+        print('expected 16 records in %s, found %d' % (os.path.relpath(OBJ, C), len(recs)))
+        return 1
+
+    fails, tiles = [], []
+    for local, f in recs:
+        model = f['model'][0]                      # obj_<something>
+        path = os.path.join(MDIR, model + '.ob2')
+        if not os.path.exists(path):
+            fails.append('%s: model %s is not on disk' % (local, model))
+            continue
+        pairs = []
+        for n in range(1, 9):
+            sv, dv = f.get('recol%ds' % n), f.get('recol%dd' % n)
+            if not sv:
+                break
+            pairs.append((int(sv[0]), int(dv[0])))
+        m = ob2render.Model(path)
+        missed = []
+        for sv, dv in pairs:
+            sh = ob2render.rgb15_to_hsl16(sv) if sv >= 100 else sv
+            if int((m.colour == sh).sum()) == 0:
+                missed.append(sh)
+        want = sorted(INERT) if (local.endswith('_max_hood') and pairs) else []
+        if sorted(missed) != want:
+            fails.append('%s: the recolour sources that match no face on %s are %s, and the spec '
+                         'says they should be %s - a source that matches nothing does nothing, so '
+                         'the piece renders as a plain Max cape'
+                         % (local, model, sorted(missed) or 'none', want or 'none'))
+        if pairs:
+            m.recolour(pairs)
+        # THE RECORD'S OWN INVENTORY CAMERA, not the renderer's default. A cape seen from the
+        # default angle is a flat sliver: 2dxan=687 is what turns it into the icon a player sees,
+        # and an icon rendered at the wrong angle tells you nothing about whether it is right.
+        cam = {}
+        for key, arg in (('2dxan', 'xan'), ('2dyan', 'yan'), ('2dzan', 'zan'),
+                         ('2dzoom', 'zoom'), ('2dxof', 'xof'), ('2dyof', 'yof')):
+            if key in f:
+                cam[arg] = int(f[key][0])
+        tiles.append((local, m, len(pairs), cam))
+        print('  %-28s %-26s %d recolour(s), %d faces, %d inert'
+              % (local, model, len(pairs), m.fcount, len(missed)))
+
+    if out_png:
+        from PIL import Image, ImageDraw
+        size, cols, pad, lab = 192, 4, 8, 16
+        rows = (len(tiles) + cols - 1) // cols
+        im = Image.new('RGB', (cols * (size + pad) + pad, rows * (size + pad + lab) + pad),
+                       (18, 18, 20))
+        d = ImageDraw.Draw(im)
+        for i, (local, m, npairs, cam) in enumerate(tiles):
+            r, c = divmod(i, cols)
+            x, y = pad + c * (size + pad), pad + r * (size + pad + lab)
+            im.paste(ob2render.render(m, size=size, **cam), (x, y))
+            d.text((x + 2, y + size + 3), '%s  %dr' % (local, npairs), fill=(190, 190, 195))
+        im.save(out_png)
+        print('wrote', out_png)
+
+    for f in fails:
+        print('  FAIL %s' % f)
+    print('ALL PASS' if not fails else '%d FAILED' % len(fails))
+    return 1 if fails else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
