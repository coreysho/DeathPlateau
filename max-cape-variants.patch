diff --git a/scripts/skillcapes/configs/max_cape_variants.enum b/scripts/skillcapes/configs/max_cape_variants.enum
new file mode 100644
index 00000000..58af6376
--- /dev/null
+++ b/scripts/skillcapes/configs/max_cape_variants.enum
@@ -0,0 +1,49 @@
+// LOOKUP TABLES FOR THE MAX CAPE VARIANTS. GENERATED - do not hand-edit.
+//   python3 tools/genmaxvariants.py
+//
+// Three tables rather than one, because three different questions get asked: what does
+// this source cape combine INTO, what hood comes with a variant, and what did a variant
+// come FROM. The third is also how "is this a variant at all" is asked - a null answer
+// means it is not one - which is why skillcape_perks.rs2 needs no list of its own.
+
+[maxvariant_cape]
+// source cape -> the variant it makes with a Max cape
+inputtype=obj
+outputtype=namedobj
+default=null
+val=tzhaar_cape_fire,fire_max_cape
+val=tzhaar_cape_infernal,infernal_max_cape
+val=saradomin_cape,saradomin_max_cape
+val=guthix_cape,guthix_max_cape
+val=zamorak_cape,zamorak_max_cape
+val=imbued_saradomin_cape,imbued_saradomin_max_cape
+val=imbued_guthix_cape,imbued_guthix_max_cape
+val=imbued_zamorak_cape,imbued_zamorak_max_cape
+
+[maxvariant_hood]
+// variant cape -> the hood that comes with it
+inputtype=obj
+outputtype=namedobj
+default=null
+val=fire_max_cape,fire_max_hood
+val=infernal_max_cape,infernal_max_hood
+val=saradomin_max_cape,saradomin_max_hood
+val=guthix_max_cape,guthix_max_hood
+val=zamorak_max_cape,zamorak_max_hood
+val=imbued_saradomin_max_cape,imbued_saradomin_max_hood
+val=imbued_guthix_max_cape,imbued_guthix_max_hood
+val=imbued_zamorak_max_cape,imbued_zamorak_max_hood
+
+[maxvariant_source]
+// variant cape -> the source cape it came from. A null answer means "not a variant".
+inputtype=obj
+outputtype=namedobj
+default=null
+val=fire_max_cape,tzhaar_cape_fire
+val=infernal_max_cape,tzhaar_cape_infernal
+val=saradomin_max_cape,saradomin_cape
+val=guthix_max_cape,guthix_cape
+val=zamorak_max_cape,zamorak_cape
+val=imbued_saradomin_max_cape,imbued_saradomin_cape
+val=imbued_guthix_max_cape,imbued_guthix_cape
+val=imbued_zamorak_max_cape,imbued_zamorak_cape
