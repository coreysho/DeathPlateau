diff --git a/scripts/areas/area_mage_arena/configs/god_cape.enum b/scripts/areas/area_mage_arena/configs/god_cape.enum
new file mode 100644
index 00000000..8e408987
--- /dev/null
+++ b/scripts/areas/area_mage_arena/configs/god_cape.enum
@@ -0,0 +1,38 @@
+// WHICH GOD A CAPE OR A STAFF BELONGS TO. GENERATED - do not hand-edit.
+//   python3 tools/genmaxvariants.py
+//
+// A cape not in this table answers ^god_none, which is how "wearing no god cape" and
+// "wearing an ordinary cape" come out the same - god_gear.rs2 leans on that.
+//
+// THE SIX MAX CAPE VARIANTS ARE IN HERE, and that is the decision this round made: the
+// wiki's God capes page lists them as god capes, and OSRS's own item table gives a
+// variant the SAME god param as the plain cape (40 Saradomin, 41 Zamorak, 42 Guthix).
+// tools/maxcapevariantspec.json records the evidence and that it is a judgement call.
+
+[god_cape_god]
+inputtype=obj
+outputtype=int
+default=0
+// saradomin
+val=saradomin_cape,^god_saradomin
+val=imbued_saradomin_cape,^god_saradomin
+val=saradomin_max_cape,^god_saradomin
+val=imbued_saradomin_max_cape,^god_saradomin
+// guthix
+val=guthix_cape,^god_guthix
+val=imbued_guthix_cape,^god_guthix
+val=guthix_max_cape,^god_guthix
+val=imbued_guthix_max_cape,^god_guthix
+// zamorak
+val=zamorak_cape,^god_zamorak
+val=imbued_zamorak_cape,^god_zamorak
+val=zamorak_max_cape,^god_zamorak
+val=imbued_zamorak_max_cape,^god_zamorak
+
+[god_staff_god]
+inputtype=obj
+outputtype=int
+default=0
+val=saradomin_staff,^god_saradomin
+val=guthix_staff,^god_guthix
+val=zamorak_staff,^god_zamorak
diff --git a/scripts/areas/area_mage_arena/configs/mage_arena.constant b/scripts/areas/area_mage_arena/configs/mage_arena.constant
index 4632d6b9..893d799b 100644
--- a/scripts/areas/area_mage_arena/configs/mage_arena.constant
+++ b/scripts/areas/area_mage_arena/configs/mage_arena.constant
@@ -14,3 +14,14 @@
 
 ^mage_arena_spell_last_cast = 98
 ^mage_arena_spell_finished = 99
+
+// WHICH GOD, as a number, so a cape or a staff can be asked rather than listed. god_cape.enum
+// and god_staff_god map every one of them to these, and a thing in neither table answers
+// ^god_none - which is how "no cape" and "an ordinary cape" come out the same.
+//
+// The order matters only in that tools/genmaxvariants.py writes the tables in it; the battery
+// checks the two agree rather than trusting that they do.
+^god_none = 0
+^god_saradomin = 1
+^god_guthix = 2
+^god_zamorak = 3
