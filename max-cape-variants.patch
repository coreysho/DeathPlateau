 [label,saradomin_mage_attack]
 // this video shows a random chance https://youtu.be/sJflCm4c-ns?list=PLn23LiLYLb1Y4vxMPWXM-CVEvOUfuAP_o&t=130
 // the zamorak battle mage says 'Hail Zamorak!' 12 times in ~150 ticks. Im guessing a 1/10 chance
-if (inv_total(worn, saradomin_staff) > 0 & (inv_total(worn, saradomin_cape) > 0 | inv_total(worn, imbued_saradomin_cape) > 0) & %npc_aggressive_player ! uid) {
+if (~god_cape_and_staff(^god_saradomin) = true & %npc_aggressive_player ! uid) {
