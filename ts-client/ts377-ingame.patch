@@ -0,0 +1,84 @@
+import { Buffer } from "../net/Buffer";
+
+/**
+ * Player chat on the wire: public chat, private messages and clan lines.
+ *
+ * This is the other half of the engine's `src/wordenc/ChatText.ts` - keep the two the same, it is
+ * the protocol, and a change to it means a new ENGINE_REVISION (381 was for this one).
+ *
+ * DeathPlateau does not use the 377 WordPack encoding. That packer squeezes a line into nibbles
+ * over a fixed table of 61 characters and is full, so it has no room for '_', '<' or '>', and no
+ * capitals at all: it lower-cases the line and capitalises each sentence, which is why ":D"
+ * arrived as ":d". A line is now simply its characters, one byte each.
+ *
+ * Reading a ChatText line with the WordPack decoder does not fail, it just produces nonsense -
+ * "ping from one" came through as "Oii ne" - so this is not an optional nicety.
+ */
+export class ChatText {
+    /** The most characters one line carries, as the chatbox input allows. */
+    public static readonly MAX_LENGTH: number = 80;
+
+    public static allowed(c: string): boolean {
+        return c >= " " && c <= "z";
+    }
+
+    /**
+     * A typed line as it will be sent and shown: characters outside the set dropped, runs of
+     * spaces made one, trimmed, cut to MAX_LENGTH, and a leading lower-case letter capitalised.
+     */
+    public static format(typed: string): string {
+        if (typed == null) {
+            return "";
+        }
+        let sb: string = "";
+        for (let i: number = 0; i < typed.length; i++) {
+            const c: string = typed.charAt(i);
+            if (!ChatText.allowed(c)) {
+                continue;
+            }
+            if (c === " " && (sb.length === 0 || sb.charAt(sb.length - 1) === " ")) {
+                continue;
+            }
+            sb += c;
+        }
+        let out: string = sb.trim();
+        if (out.length > ChatText.MAX_LENGTH) {
+            out = out.substring(0, ChatText.MAX_LENGTH).trim();
+        }
+        if (out.length > 0 && out.charAt(0) >= "a" && out.charAt(0) <= "z") {
+            out = out.charAt(0).toUpperCase() + out.substring(1);
+        }
+        return out;
+    }
+
+    /**
+     * Write a line as one byte per character, dropping anything outside the set.
+     *
+     * The send side matters as much as the read side and is easier to miss: this client packed
+     * outgoing chat with WordPack, whose output bytes are mostly table indices below 32. The
+     * engine reads them as characters and drops everything outside ' '..'z', so "hello world 123"
+     * left as 15 characters, went out as 8 nibble-packed bytes and reached the other player as
+     * three - "A@I". The sender's own chatbox showed the line correctly the whole time, because
+     * that is drawn from the local copy and never makes the round trip.
+     */
+    public static pack(text: string, buffer: Buffer): void {
+        for (let i: number = 0; i < text.length && i < ChatText.MAX_LENGTH; i++) {
+            const c: string = text.charAt(i);
+            if (ChatText.allowed(c)) {
+                buffer.putByte(c.charCodeAt(0));
+            }
+        }
+    }
+
+    /** Read `length` bytes of a line the server sent. Anything outside the set is dropped. */
+    public static unpack(buffer: Buffer, length: number): string {
+        let out: string = "";
+        for (let i: number = 0; i < length; i++) {
+            const c: string = String.fromCharCode(buffer.getUnsignedByte());
+            if (ChatText.allowed(c)) {
+                out += c;
+            }
+        }
+        return out;
+    }
+}
