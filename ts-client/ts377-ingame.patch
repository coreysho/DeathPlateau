+     * coordinates while the two sizes agree. The page sizes the canvas with CSS so it fits the
+     * window - on a phone it has to - and every click then lands off by the stretch ratio, further
+     * out the nearer the edge. The backing store is the frame the client drew, so scale into it.
+     */
+    private eventX(e: MouseEvent): number {
+        const r = this.canvas.getBoundingClientRect();
+        return r.width > 0 ? Math.round((e.clientX - r.left) * (this.canvas.width / r.width)) : e.offsetX;
+    }
