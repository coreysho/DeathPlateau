+// somewhere real rather than at coord 0.
 [proc,poh_leave]
-p_telejump(^poh_exit);
+p_telejump(~poh_exit_coord);
 ~poh_free;
 
+[proc,poh_exit_coord]()(coord)
+def_coord $exit = enum(int, coord, poh_loc_exit, %poh_location);
+if ($exit = null) {
+    return(^poh_exit);
+}
+return($exit);
