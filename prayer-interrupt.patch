diff --git a/scripts/skill_prayer/scripts/prayers/clarity.rs2 b/scripts/skill_prayer/scripts/prayers/clarity.rs2
index be580363..5e2e3d73 100644
--- a/scripts/skill_prayer/scripts/prayers/clarity.rs2
+++ b/scripts/skill_prayer/scripts/prayers/clarity.rs2
@@ -24,7 +24,19 @@ queue(retry_prayer_clarity, 0, 0);
 @activate_prayer_clarity;
 
 [label,activate_prayer_clarity]
-p_clearpendingaction; // https://youtu.be/j-Z-43CzpZQ?t=120, https://youtu.be/NT74s7nJwAo?t=21, https://www.youtube.com/watch?v=fcRgR_4ZbdA
+// A PRAYER TOGGLE NO LONGER STOPS WHAT YOU WERE DOING. p_clearpendingaction used to sit here and
+// it nulls Player.target, so turning a prayer on dropped whatever you were attacking - half of
+// "actions get cancelled for doing anything", reported from play 2026-09-21.
+//
+// THIS IS A DELIBERATE DIVERGENCE FROM UPSTREAM, decided by Corey on 2026-09-21, and upstream had
+// evidence: clarity.rs2 carried three pieces of period footage for the line. The argument for
+// keeping it was 2006 authenticity; the argument for removing it is that this server should feel
+// like Old School, where prayers are free and 1-tick flicking is ordinary. The videos are kept in
+// clarity.rs2 beside the decision so the next reader can see what was traded away.
+//
+// combat_battery group 4 pins the new behaviour the way it used to pin the old one.
+// The footage upstream cited for the line that used to be here:
+// https://youtu.be/j-Z-43CzpZQ?t=120, https://youtu.be/NT74s7nJwAo?t=21, https://www.youtube.com/watch?v=fcRgR_4ZbdA
 def_dbrow $data = ~get_prayer_data(^prayer_clarity);
 if ($data = null) {
     return;
