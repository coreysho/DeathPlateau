From c4bd2bc10b801751cefe522ebd0d615a3d93ae37 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 14 Sep 2026 15:20:18 +0000
Subject: [PATCH] Guard the null the enum sweep uncovered on every login

script error: nc_param An input for a Npc type was not valid to use.
Input was -1. - macro_events.rs2:83, [queue,macro_event_login], every login.

%macro_event is 0 when no random event was following at logout, which is
almost every login, and both event tables start at val=1, so the lookup
misses. Before the sweep it answered npc 0 - hans - and nc_param quietly
returned false. With default=null it answers null and nc_param throws.

The feature could never have worked either way: hans carries no
follow_player_on_logout param, so the test was always false. The default
turned a silent dead feature into a loud one.

Guarded, and the same lookup in ~macro_event_general_spawn moved above the
%macro_event write so nothing is marked as the active event without an npc
to be it.

Every call site of all 61 swept enums was then checked against its enum's
key range. This was the only one; the audit table is in
claude/enum-default-sweep.md. The dangerous pattern is a 1-based table read
with a varp whose 0 means "none".

rs2check 0 ERROR / 0 CHECK; poh_battery ALL PASS.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J1qUhTcu63bJ3hCBBxy7nU
---
 scripts/macro events/scripts/macro_events.rs2 | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/scripts/macro events/scripts/macro_events.rs2 b/scripts/macro events/scripts/macro_events.rs2
index b5b4532e..3979a155 100644
--- a/scripts/macro events/scripts/macro_events.rs2	
+++ b/scripts/macro events/scripts/macro_events.rs2	
@@ -31,8 +31,13 @@ def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk)
 if ($event_coord = null) {
     return;
 }
-%macro_event = $event;
+// the same null, one call earlier: nothing may be marked as the active event if there is no npc
+// to be it, so the lookup comes BEFORE %macro_event is written.
 def_npc $event_npc = ~macro_event_npc($event);
+if ($event_npc = null) {
+    return;
+}
+%macro_event = $event;
 npc_add($event_coord, $event_npc, 1000);
 %macro_event_uid = npc_uid;
 session_log(^log_moderator, "Random event spawned: <nc_debugname(npc_type)>");
@@ -77,10 +82,20 @@ if (%macro_event > 0) {
 return(true);
 
 // called when the player logs in
+//
+// %macro_event is 0 when no random event was following at logout, which is almost every login, and
+// both event tables start at val=1 - so the lookup MISSES. Before enums were given default= it
+// answered npc 0, which is hans, and nc_param quietly said false. With default=null it answers null
+// and nc_param throws "An input for a Npc type was not valid to use. Input was -1." on every login.
+// The guard is the fix; the enum was never the bug, it just stopped hiding this one.
 [queue,macro_event_login]
 def_int $macro_event = %macro_event;
 %macro_event = 0;
-if (nc_param(~macro_event_npc($macro_event), follow_player_on_logout) = ^true) {
+def_npc $event_npc = ~macro_event_npc($macro_event);
+if ($event_npc = null) {
+    return;
+}
+if (nc_param($event_npc, follow_player_on_logout) = ^true) {
     ~macro_event_general_spawn($macro_event);
 }
 
