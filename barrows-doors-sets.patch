diff --git a/scripts/areas/area_barrows/configs/barrows.constant b/scripts/areas/area_barrows/configs/barrows.constant
index 508d14f4..33a8ae37 100644
--- a/scripts/areas/area_barrows/configs/barrows.constant
+++ b/scripts/areas/area_barrows/configs/barrows.constant
@@ -218,3 +218,25 @@
 // thirty ticks in the middle of a fight is worse than no picture.
 ^barrows_drain_interval = 30
 ^barrows_drain_base = 8
+
+// =============================================================================================
+// THE SIX ARMOUR SETS
+// =============================================================================================
+// A DIFFERENT SIX FROM THE BROTHERS' OWN. These are what a player gets for wearing a full set -
+// helm, body, legs and weapon from one brother - and none of them existed in the build. The wiki's
+// wording for each is at the top of scripts/barrows_sets.rs2; tools/barrowsspec.json has the
+// numbers. All four pieces at any state of degradation count, which is what param=barrows_set and
+// the pieces' own param=fixed are for.
+//
+// The set ids are each brother's ^barrows_bit_* PLUS ONE, so 0 can mean "not a Barrows piece" -
+// the same trick %barrows_entry_crypt uses.
+^barrows_set_ahrim = 1
+^barrows_set_dharok = 2
+^barrows_set_guthan = 3
+^barrows_set_karil = 4
+^barrows_set_torag = 5
+^barrows_set_verac = 6
+
+// Five of the six fire on a quarter of qualifying hits, which is one number and not five. Dharok's
+// is not in this list: his is not a chance, it is arithmetic on every hit.
+^barrows_set_effect_pct = 25
