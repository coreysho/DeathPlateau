From 8fcaafb2b7fd61d3cab1d2e1b608d861fce189bd Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Fri, 18 Sep 2026 17:45:06 +0000
Subject: [PATCH] XP lock: an [if_button] is not handed p_active_player

The build refused all 22 triggers: ~p_choice2 reaches p_pausebutton and an
[if_button] gets active_player only. claude/rs2-player-pointer-contexts.md says so
in a table, and this round did not read it.

Every body now opens with p_finduid, the same shape [label,magic_teleport] uses and
the spellbook buttons reach. That fixes a second fault the compiler never would have
reported: %xp_locked is protect=yes, and writing a protected varp from an unprotected
script compiles clean and drops the connection when it runs. Taking the pointer fixes
both without opening the varp up.

gamemode_battery checks all three - the guard is the first line, every write is inside
it, and the varp is still protected - and gamemode_mutate breaks each one.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015mjzJ5S7cQ1h1aE5KeBabD
---
 scripts/gamemodes/scripts/xplock.rs2 | 664 +++++++++++++++++----------
 tools/gamemode_battery.py            |  21 +
 tools/gamemode_mutate.py             |  10 +-
 tools/genxplock.py                   |  34 +-
 4 files changed, 474 insertions(+), 255 deletions(-)

diff --git a/scripts/gamemodes/scripts/xplock.rs2 b/scripts/gamemodes/scripts/xplock.rs2
index 4eb38884..bf6f6ffd 100644
--- a/scripts/gamemodes/scripts/xplock.rs2
+++ b/scripts/gamemodes/scripts/xplock.rs2
@@ -15,6 +15,10 @@
 // a lock never touches a level - which is the whole point of Corey's constraint: locking a skill
 // must not be a way to be handed the dragon mace or the better gloves.
 //
+// WHAT AN [if_button] IS NOT HANDED. p_active_player. It gets active_player and nothing more, so
+// every one of these bodies opens with p_finduid - see claude/rs2-player-pointer-contexts.md, which
+// says so in a table this round did not read until the build refused twenty-two scripts.
+//
 // WHAT THE HOVER PANEL SHOWS. A locked skill's second row says "XP locked" where it said
 // "Next Level At:". That is the whole display: blank is the cache state, so an account with
 // nothing locked pushes nothing at login, and the restore string is the interface's own.
@@ -104,331 +108,507 @@ if (~xplock_is(^xplock_construction) = true) {
 }
 
 [if_button,stats:xplock_attack]
-if (~xplock_is(^xplock_attack) = true) {
-    if (~p_choice2("Unlock Attack experience?", 1, "No, keep it locked.", 2) = 1) {
-        %xp_locked = clearbit(%xp_locked, ^xplock_attack);
-        if_settext(stats:com_125, "Next Level At:");
-        mes("Your Attack experience is no longer locked.");
+// p_finduid FIRST. An [if_button] is handed active_player and NOT p_active_player -
+// see claude/rs2-player-pointer-contexts.md - so both halves of this body need it:
+// ~p_choice2 reaches p_pausebutton, which is a build error without it, and writing a
+// protect=yes varp from an unprotected script compiles fine and DROPS THE CONNECTION
+// when it runs. Taking the pointer fixes both and keeps the varp protected. Same shape
+// as [label,magic_teleport], which the spellbook buttons reach.
+if (p_finduid(uid) = true) {
+    if (~xplock_is(^xplock_attack) = true) {
+        if (~p_choice2("Unlock Attack experience?", 1, "No, keep it locked.", 2) = 1) {
+            %xp_locked = clearbit(%xp_locked, ^xplock_attack);
+            if_settext(stats:com_125, "Next Level At:");
+            mes("Your Attack experience is no longer locked.");
+        }
+        return;
+    }
+    if (~p_choice2("Lock Attack experience?", 1, "No, leave it.", 2) = 1) {
+        %xp_locked = setbit(%xp_locked, ^xplock_attack);
+        if_settext(stats:com_125, "@red@XP locked");
+        mes("Your Attack experience is locked. You will gain no more of it.");
     }
-    return;
-}
